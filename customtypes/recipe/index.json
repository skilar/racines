{
    "id": "recipe",
    "label": "Recipe",
    "repeatable": true,
    "json": {
        "Main": {
            "uid": {
                "type": "UID",
                "config": {
                    "label": "UID"
                }
            },
            "title": {
                "type": "StructuredText",
                "config": {
                    "label": "Title",
                    "placeholder": "",
                    "single": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
                    "labels": ["ordinal-nums", "small-caps"],
                    "allowTargetBlank": true
                }
            },
            "slices": {
                "type": "Slices",
                "fieldset": "Slice Zone",
                "config": {
                    "choices": {
                        "image_list": {
                            "type": "SharedSlice"
                        },
                        "text": {
                            "type": "SharedSlice"
                        },
                        "image": {
                            "type": "SharedSlice"
                        }
                    }
                }
            }
        },
        "SEO & Metadata": {
            "meta_title": {
                "type": "Text",
                "config": {
                    "label": "Meta Title",
                    "placeholder": "A title of the page used for social media and search engines"
                }
            },
            "meta_description": {
                "type": "Text",
                "config": {
                    "label": "Meta Description",
                    "placeholder": "A brief summary of the page"
                }
            },
            "meta_image": {
                "type": "Image",
                "config": {
                    "label": "Meta Image",
                    "constraint": {
                        "width": 2400,
                        "height": 1260
                    },
                    "thumbnails": []
                }
            }
        }
    },
    "status": true,
    "format": "page"
}
