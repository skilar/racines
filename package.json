{
    "name": "Racines Versailles",
    "type": "module",
    "version": "1.4.1",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "astro": "astro",
        "build": "eslint src && astro check && astro build",
        "check": "astro check",
        "dev": "astro dev --host",
        "lint": "eslint src",
        "preview": "astro preview",
        "prismic:pull": "node --env-file-if-exists=.env scripts/prismic-models.ts pull",
        "prismic:push": "node --env-file-if-exists=.env scripts/prismic-models.ts push",
        "prismic:status": "node --env-file-if-exists=.env scripts/prismic-models.ts status",
        "release": "dotenv run release-it",
        "test": "node --test src/**/*.test.ts",
        "typegen": "npx prismic-ts-codegen"
    },
    "dependencies": {
        "@astrojs/netlify": "^8.2.14",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.6",
        "@prismicio/client": "^7.23.1",
        "@skilar/jolitypo-ts": "^0.1.0",
        "astro": "^7.4.13"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/ts-plugin": "^1.11.0",
        "@eslint/js": "^10.0.1",
        "@netlify/edge-functions": "^4.0.2",
        "@prismicio/custom-types-client": "^2.1.0",
        "@prismicio/types": "^0.2.9",
        "@types/node": "^26.6.6",
        "dotenv": "^18.0.10",
        "dotenv-cli": "^11.1.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.2.1",
        "prettier": "^3.10.1",
        "prettier-plugin-astro": "^1.1.2",
        "prismic-ts-codegen": "^0.1.31",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0"
    },
    "prettier": {
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-astro"
        ],
        "overrides": [
            {
                "files": "*.astro",
                "options": {
                    "parser": "astro"
                }
            }
        ]
    },
    "release-it": {
        "git": {
            "changelog": "npx auto-changelog --stdout --commit-limit false --unreleased --template https://raw.githubusercontent.com/release-it/release-it/master/templates/changelog-compact.hbs",
            "commitMessage": "Releasing v${version}",
            "tagName": "v${version}"
        },
        "github": {
            "release": true,
            "releaseName": "v${version}",
            "tokenRef": "GITHUB_TOKEN"
        },
        "hooks": {
            "after:bump": "npx auto-changelog -p --commit-limit false --template changelog-template.hbs --ignore-commit-pattern \"^(Releasing v.*)\""
        },
        "npm": {
            "publish": false
        }
    }
}
