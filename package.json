{
    "name": "Racines",
    "type": "module",
    "version": "0.1.1",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "astro": "astro",
        "build": "eslint src && astro check && astro build",
        "check": "astro check",
        "dev": "astro dev --host",
        "lint": "eslint src",
        "preview": "astro preview",
        "prismic:pull": "node --env-file-if-exists=.env scripts/prismic-models.ts pull",
        "prismic:push": "node --env-file-if-exists=.env scripts/prismic-models.ts push",
        "prismic:status": "node --env-file-if-exists=.env scripts/prismic-models.ts status",
        "release": "dotenv release-it",
        "typegen": "npx prismic-ts-codegen"
    },
    "dependencies": {
        "@astrojs/netlify": "^8.2.0",
        "@astrojs/sitemap": "^3.7.3",
        "@prismicio/client": "^7.21.8",
        "astro": "^7.2.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/ts-plugin": "^1.10.10",
        "@eslint/js": "^10.0.1",
        "@prismicio/custom-types-client": "^2.1.0",
        "@prismicio/types": "^0.2.9",
        "@types/node": "^26.2.0",
        "dotenv": "^17.4.2",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prismic-ts-codegen": "^0.1.30",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "prettier": {
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-astro"
        ],
        "overrides": [
            {
                "files": "*.astro",
                "options": {
                    "parser": "astro"
                }
            }
        ]
    },
    "release-it": {
        "git": {
            "changelog": "npx auto-changelog --stdout --commit-limit false --unreleased --template https://raw.githubusercontent.com/release-it/release-it/master/templates/changelog-compact.hbs",
            "commitMessage": "Releasing v${version}",
            "tagName": "v${version}"
        },
        "github": {
            "release": true,
            "releaseName": "v${version}",
            "tokenRef": "GITHUB_TOKEN"
        },
        "hooks": {
            "after:bump": "npx auto-changelog -p --commit-limit false --template changelog-template.hbs --ignore-commit-pattern \"^(Releasing v.*)\""
        },
        "npm": {
            "publish": false
        }
    }
}
