---
import getStaticPrismicPaths from '@lib/get-static-prismic-paths'

import Workshop from '@components/pages/Workshop/Workshop.astro'

export async function getStaticPaths() {
    return await getStaticPrismicPaths({ lang: 'en-us', type: 'workshop' })
}

const { uid } = Astro.params
---

<Workshop uid={uid} />
