---
import getStaticPrismicPaths from '@lib/get-static-prismic-paths'

import NotebookPost from '@components/pages/NotebookPost/NotebookPost.astro'

export async function getStaticPaths() {
    return await getStaticPrismicPaths({ lang: 'en-us', type: 'notebook_post' })
}

const { uid } = Astro.params
---

<NotebookPost uid={uid} />
