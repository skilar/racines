---
import getStaticPrismicPaths from '@lib/get-static-prismic-paths'

import JournalEntry from '@components/pages/JournalEntry/JournalEntry.astro'

export async function getStaticPaths() {
    return await getStaticPrismicPaths({ lang: 'fr-fr', type: 'blog_post' })
}

const { uid } = Astro.params
---

<JournalEntry uid={uid} />
