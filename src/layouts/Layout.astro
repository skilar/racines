---
import { LOCALES } from '@lib/i18n'

import Head from '@components/layout/Head.astro'
import SkipToContentLink from '@components/layout/SkipToContentLink.astro'
import '@styles/styles.css'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const props = Astro.props
const { lang } = Astro.locals
---

<html lang={LOCALES[lang].bcp47}>
    <Head {...props} />

    <body>
        <SkipToContentLink />
        <slot />
    </body>
</html>

<style>
    body {
        --padding-block: calc(var(--space-7) * 2);
        --padding-inline: var(--space-4);

        background-color: var(--color-white);
        display: grid;
        grid-template-rows: min-content 1fr min-content;
        min-height: 100svh;

        @media (width > 650px) {
            --padding-block: calc(var(--space-9) * 2);
            --padding-inline: var(--space-5);
        }
    }
</style>
