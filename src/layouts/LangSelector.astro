---
import { getLangLinks } from '@lib/get-lang-links'

import type { AlternateLanguage } from '@prismicio/client'
import type { Lang } from '@lib/constants'

interface Props {
    alternateLanguages?: AlternateLanguage[] | undefined
    lang: Lang
}

const { alternateLanguages, lang } = Astro.props

const links = getLangLinks({
    alternateLanguages,
    currentPath: Astro.url.pathname,
    lang,
})
---

<ul class="langs">
    {
        links.map((link, index) => (
            <Fragment>
                {index > 0 && <li>/</li>}
                <li>
                    <a
                        class:list={[{ selected: link.selected }]}
                        href={link.href}
                    >
                        {link.label}
                    </a>
                </li>
            </Fragment>
        ))
    }
</ul>

<style>
    .langs {
        --text-color: var(--color-blue-10);
        color: var(--text-color);
        display: inline-flex;
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-medium);
        gap: var(--space-3);
        padding-block: var(--space-2);
        position: absolute;
        right: var(--padding-inline);
        top: 0;

        a {
            color: var(--text-color);
            text-decoration: none;

            &.selected,
            &:hover {
                text-decoration: underline;
                text-decoration-thickness: 1px;
                text-underline-offset: 3px;
            }
        }

        @container header (width > 850px) {
            --text-color: var(--color-ivory);
            background-color: var(--color-blue-10);
            padding-inline: var(--space-3);
        }
    }
</style>
