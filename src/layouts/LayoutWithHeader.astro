---
import { isFilled } from '@prismicio/client'
import { client } from '@lib/prismic'

import PrismicRichText from '@components/common/PrismicRichText.astro'
import Layout from './Layout.astro'
import LangSelector from './LangSelector.astro'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const { alternateLanguages, lang, ...props } = Astro.props

const page = await client.getSingle('layout', { lang })
---

<Layout lang={lang} {...props}>
    <header>
        <div class="header">
            {
                isFilled.keyText(page.data.title) && (
                    <a class="title" href="/">
                        {page.data.title}
                    </a>
                )
            }

            <PrismicRichText class="subtitle" richText={page.data.subtitle} />
        </div>

        <LangSelector alternateLanguages={alternateLanguages} lang={lang} />
    </header>

    <slot />
</Layout>

<style>
    header {
        align-items: center;
        display: flex;
        justify-content: space-between;
        margin-block: var(--space-4) var(--space-5);
        margin-inline: auto;
        max-width: var(--text-max-width);
        padding-block: var(--space-4);
    }

    .header {
        align-items: baseline;
        display: flex;
        gap: var(--space-4);
        justify-content: start;
    }

    .title {
        align-items: center;
        color: var(--color-blue-10);
        display: flex;
        font-family: var(--font-headline);
        font-size: var(--font-size-6);
        font-variant-caps: all-small-caps;
        font-variation-settings: 'opsz' 10;
        font-weight: var(--font-weight-medium);
        gap: var(--space-2);
        letter-spacing: 1px;
        margin-bottom: 0;
        text-decoration: none;

        &:hover {
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 4px;
        }
    }

    .subtitle {
        color: var(--color-grey-11);
        font-size: var(--font-size-4);
    }
</style>
