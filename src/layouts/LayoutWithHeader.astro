---
import { client } from '@lib/prismic'

import Footer from '@components/layout/Footer.astro'
import Header from '@components/layout/Header.astro'
import Layout from './Layout.astro'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const { alternateLanguages, lang, ...props } = Astro.props

const page = await client.getSingle('layout', { lang })
---

<Layout lang={lang} {...props}>
    <Header
        alternateLanguages={alternateLanguages}
        lang={lang}
        menu={page.data.menu}
        subtitle={page.data.subtitle}
        title={page.data.title}
    />

    <div class="wrapper">
        <slot />
    </div>

    <Footer text={page.data.text} />
</Layout>

<style>
    .wrapper {
        --padding-block: calc(var(--space-7) * 2);
        --padding-inline: var(--space-5);

        padding-inline: var(--padding-inline);

        @media (width > 650px) {
            --padding-block: calc(var(--space-9) * 2);
        }
    }
</style>
