---
import { client } from '@lib/prismic'

import Footer from '@components/layout/Footer.astro'
import Header from '@components/layout/Header.astro'
import Layout from './Layout.astro'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const { alternateLanguages, ...props } = Astro.props
const { lang } = Astro.locals

const page = await client.getSingle('layout', { lang })
---

<Layout {...props}>
    <Header
        alternateLanguages={alternateLanguages}
        menu={page.data.menu}
        subtitle={page.data.subtitle}
        title={page.data.title}
    />

    <slot />

    <Footer legal={page.data.legal} slices={page.data.slices1} />
</Layout>
