---
import { isFilled } from '@prismicio/client'

import Input from '../common/forms/Input.astro'
import Button from '../common/Button.astro'
import PrismicRichText from '../common/PrismicRichText.astro'

import type { NewsletterSignupFormSlice } from '@typez/generated/prismic'

interface Props {
    slice: NewsletterSignupFormSlice
}

const { slice } = Astro.props
---

<div class="container" data-slice-type={slice.slice_type}>
    {isFilled.keyText(slice.primary.title) && <h2>{slice.primary.title}</h2>}

    {
        isFilled.richText(slice.primary.caption) && (
            <PrismicRichText class="caption" richText={slice.primary.caption} />
        )
    }

    <!-- TODO: Add i18n for these fields -->
    <form>
        <div class="newsletterForm">
            <div class="names">
                <Input label="First Name" name="first_name" type="text" />
                <Input label="Last Name" name="last_name" type="text" />
            </div>

            <Input
                aria-describedby="error"
                label="Email Address"
                name="email_address"
                placeholder="example@example.com"
                required
                type="email"
            />
        </div>

        <Button caption="Sign Up" class="newsletterButton" type="submit" />
    </form>

    <script>
        import { actions, isInputError } from 'astro:actions'

        const form = document.querySelector('form')

        form?.addEventListener('submit', async (event) => {
            event.preventDefault()
            const formData = new FormData(form)
            const { error } = await actions.newsletter(formData)

            if (isInputError(error)) {
                if (error.fields.email_address) {
                    const message = error.fields.email_address.join(', ')
                    console.log(message)
                }
            } else {
                // do something
            }
        })
    </script>
</div>

<style>
    .container {
        border-block: var(--double-border);
        font-size: var(--font-size-4);
        max-width: var(--width-text);
        padding-block: var(--space-6) var(--space-7);
    }

    h2 {
        font-size: var(--font-size-5);
        margin-bottom: var(--space-4);
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
    }

    .caption {
        margin-bottom: var(--space-5);

        p:has(+ p) {
            margin-bottom: var(--space-5);
        }
    }

    .newsletterForm {
        display: grid;
        gap: var(--space-4);
        padding-bottom: var(--space-7);
    }

    .names {
        display: flex;
        gap: var(--space-5);
    }

    .newsletterButton {
        width: 100%;
    }
</style>
