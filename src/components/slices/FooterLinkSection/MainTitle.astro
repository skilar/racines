---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../../common/PrismicRichText.astro'

import type {
    FooterLinkSectionSlice,
    FooterLinkSectionSliceDefault,
} from '@typez/generated/prismic'

interface Props {
    slice: FooterLinkSectionSliceDefault
    sliceType: FooterLinkSectionSlice['slice_type']
}

const { slice, sliceType } = Astro.props
---

<div class="container" data-slice-type={sliceType}>
    {isFilled.richText(slice.primary.title) && (
        <PrismicRichText class="title" richText={slice.primary.title} />
    )}

    <PrismicRichText class="subtitle" richText={slice.primary.subtitle} />
    <PrismicRichText class="caption" richText={slice.primary.caption} />
</div>

<style>
    .container {
        border-bottom: var(--double-border);
        grid-column: 1 / 3;
        grid-row: 1;
        padding-bottom: var(--space-7);
        text-align: left;

        @container footer (width > 45rem) {
            border: none;
            padding: 0;
        }

        @container footer (width > 60rem) {
            grid-column: unset;
            grid-row: unset;
            text-align: center;
        }
    }

    .title {
        color: var(--color-blue-10);
        font-size: var(--font-size-5);
        font-style: italic;
        font-weight: var(--font-weight-bold);
        line-height: 1.1;
        margin-bottom: 0;
    }

    .subtitle {
        color: var(--color-red-8);
        font-size: var(--font-size-4);
        font-weight: var(--font-weight-medium);
    }

    .caption {
        font-size: var(--font-size-3);
        margin-top: var(--space-3);
    }
</style>
