---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'

import type { QuoteSlice } from '@typez/generated/prismic'

interface Props {
    slice: QuoteSlice
}

const { slice } = Astro.props
---

<div class="container" data-slice-type={slice.slice_type}>
    <div class="prose quoteSlice">
        {
            isFilled.keyText(slice.primary.title) && (
                <h2 class="title">{slice.primary.title}</h2>
            )
        }

        {
            isFilled.richText(slice.primary.caption) && (
                <PrismicRichText
                    class="description"
                    richText={slice.primary.caption}
                />
            )
        }
    </div>
</div>

<style>
    .container {
        --post-line-height: var(--line-height-default);
        --post-text-size: var(--font-size-4);
        --post-line: calc(
            (var(--post-line-height) * var(--post-text-size)) / 2
        );

        background-color: var(--color-ivory-2);
        padding-block: calc(var(--space-9) * 2);
        padding-inline: var(--space-7);
        width: 100%;
    }

    .quoteSlice {
        font-size: var(--font-size-4-sc);
        margin-inline: auto;
        max-width: var(--width-text);
        text-align: center;

    .title {
        font-size: var(--font-size-5);
        margin-bottom: var(--space-5);
    }
    }
</style>
