---
import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { HomepageDocument } from '@typez/prismic'

interface Props {
    slice: HomepageDocument['data']['slices'][number]
}

const { slice } = Astro.props
---

<div class="hero">
    {
        slice.primary.image.url && (
            <img src={slice.primary.image.url} alt={slice.primary.image.alt} />
        )
    }

    <div>
        {slice.primary.title && <h2>{slice.primary.title}</h2>}
        <PrismicRichText
            class="description"
            richText={slice.primary.description}
        />
    </div>
</div>

<style>
    .hero {
        border-top: 4px double var(--color-blue-10);
        display: grid;
        gap: var(--space-5);
        padding-top: var(--space-4);

        &:has(> div:has(+ div)) {
            grid-template-columns: 20vw 50ch;
        }

        &:has(+ .hero) {
            margin-bottom: var(--space-9);
        }
    }

    h2 {
        color: var(--color-blue-10);
        font-size: var(--font-size-5);
        font-variation-settings: 'opsz' 6;
        margin-bottom: var(--space-3);
    }

    .description {
        font-size: var(--font-size-4);
        line-height: 1.4;

        h3 {
            font-variation-settings: 'opsz' 6;
            margin-bottom: var(--space-3);
        }

        p {
            &:has(+ h3) {
                margin-bottom: var(--space-7);
            }

            &:has(+ p) {
                margin-bottom: var(--space-5);
            }
        }
    }

    img {
        display: block;
        max-width: 100%;
    }
</style>
