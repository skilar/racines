---
import { isFilled } from '@prismicio/client'

import Image from '@components/common/Image.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { HeroSlice } from '@typez/generated/prismic'

interface Props {
    slice: HeroSlice
}

const { slice } = Astro.props
---

<div class="container" data-slice-type={slice.slice_type}>
    {
        isFilled.image(slice.primary.image) && (
            <div class="image">
                <Image image={slice.primary.image} quality={75} />
            </div>
        )
    }

    <div>
        {slice.primary.title && <h2>{slice.primary.title}</h2>}
        <PrismicRichText
            class="description"
            richText={slice.primary.description}
        />
    </div>
</div>

<style>
    .container {
        border-top: var(--double-border);
        padding-top: var(--space-5);
        max-width: var(--width-text);

        &:has(> div + div) {
            display: grid;
            gap: var(--space-5);
            grid-template-columns: 20vw 65ch;
            margin-left: -13.333vw;
            margin-left: -10vw;
        }
    }

    .image {
        max-width: 20vw;
        width: 100%;
    }

    h2 {
        color: var(--color-blue-10);
        font-size: var(--font-size-5);
        font-variation-settings: 'opsz' 6;
        margin-bottom: var(--space-5);
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
    }

    .description {
        font-size: var(--font-size-4);
        line-height: 1.4;

        h3 {
            font-variation-settings: 'opsz' 6;
            margin-bottom: var(--space-3);
        }

        p {
            &:has(+ h3) {
                margin-bottom: var(--space-6);
            }

            &:has(+ p) {
                margin-bottom: var(--space-5);
            }
        }
    }

    img {
        display: block;
        max-width: 100%;
    }
</style>
