---
import { isFilled } from '@prismicio/client'

import Image from '@components/common/Image.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { HeroSlice } from '@typez/prismic'

interface Props {
    slice: HeroSlice
}

const { slice } = Astro.props
---

<div class="hero" data-slice-type={slice.slice_type}>
    {
        isFilled.image(slice.primary.image) && (
            <div class="image">
                <Image image={slice.primary.image} quality={75} />
            </div>
        )
    }

    <div>
        {slice.primary.title && <h2>{slice.primary.title}</h2>}
        <PrismicRichText
            class="description"
            richText={slice.primary.description}
        />
    </div>
</div>

<style>
    .hero {
        display: grid;
        gap: var(--space-5);
    }

    h2 {
        font-family: var(--font-serif);
        font-size: var(--font-size-5);
        font-variation-settings: 'CNTR' 100;
        font-weight: var(--font-weight-black);
        margin-bottom: var(--space-3);
    }

    .description {
        line-height: 1.4;
    }

    img {
        display: block;
        max-width: 100%;
    }
</style>
