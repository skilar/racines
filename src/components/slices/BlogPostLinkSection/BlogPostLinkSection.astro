---
import { isFilled } from '@prismicio/client'
import { fixText } from '@lib/get-fixer'
import { toJournalItem } from '@lib/get-journal-items'
import { client } from '@lib/prismic'
import { getLinkAttrs } from '@lib/prismic-link-resolver'

import PrismicRichText from '@components/common/PrismicRichText.astro'
import BlogPostItem from './BlogPostItem.astro'

import type { JournalItem } from '@lib/get-journal-items'
import type { JournalDocument } from '@lib/prismic'
import type { BlogPostLinkSectionSlice } from '@typez/generated/prismic'

interface Props {
    slice: BlogPostLinkSectionSlice
}

const { slice } = Astro.props
const { lang } = Astro.locals

const linkAttrs = getLinkAttrs(slice.primary.link)

const ids = slice.primary.blog_posts
    .map(({ blog_post: post }) => post)
    .filter(isFilled.contentRelationship)
    .map((post) => post.id)

const documents = ids.length
    ? await client.getAllByIDs<JournalDocument>(ids, { lang })
    : []
const documentsById = new Map(documents.map((doc) => [doc.id, doc]))

// The API does not keep the editor's order and drops unpublished entries.
const items: JournalItem[] = ids.flatMap((id) => {
    const doc = documentsById.get(id)

    return doc ? [toJournalItem(doc, lang)] : []
})
---

<div class="container" data-slice-type={slice.slice_type}>
    <div class="wrapper">
        <div>
            {isFilled.keyText(slice.primary.title) && (
                <h2>{fixText(slice.primary.title, lang)}</h2>
            )}

            <PrismicRichText
                class="description"
                richText={slice.primary.caption}
            />

            {linkAttrs && isFilled.keyText(slice.primary.link.text) && (
                <a class="journalLink" {...linkAttrs}>
                    <span class="linkTitle">
                        {fixText(slice.primary.link.text, lang)}
                    </span>
                    <span class="arrow">→</span>
                </a>
            )}
        </div>

        {items.length > 0 && (
            <div class="blogPostsContainer">
                <ul class="blogPosts">
                    {items.map((item) => (
                        <BlogPostItem item={item} />
                    ))}
                </ul>
            </div>
        )}
    </div>
</div>

<style>
    .container {
        container: featuredBlogPosts / inline-size;
    }

    .wrapper {
        border-block: var(--double-border);
        display: grid;
        gap: var(--space-5);
        margin-block: var(--space-8);
        padding-block: var(--space-7);

        @container featuredBlogPosts (width > 50rem) {
            grid-template-columns: 18rem 1fr;
        }
    }

    h2 {
        color: var(--color-blue-10);
        font-size: var(--font-size-5);
        margin-bottom: var(--space-3);
        text-box-edge: cap alphabetic;
        text-box-trim: trim-both;
    }

    .description {
        font-size: var(--font-size-4);
        margin-bottom: var(--space-5);
    }

    .journalLink {
        color: var(--color-red-8);
        display: inline-flex;
        font-size: var(--font-size-4);
        font-weight: var(--font-weight-bold);
        gap: var(--space-1);
        text-decoration: none;

        .arrow {
            transition: translate 200ms ease-in-out;
        }

        &:hover {
            .linkTitle {
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-1);
            }

            .arrow {
                translate: var(--space-2) 0;
            }
        }
    }

    .blogPostsContainer {
    }

    .blogPosts {
        container: featuredBlogPostsList / inline-size;
        display: grid;
        gap: var(--space-7);
    }
</style>
