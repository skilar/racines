---
import { isFilled } from '@prismicio/client'
import { getBoldImages, isBoldImageList } from '@lib/bold-images'
import { getEntryTitleHtml } from '@lib/get-entry-title'
import getJournalEntryDate from '@lib/get-journal-entry-date'

import Image from '../../common/Image.astro'
import PrismicRichText from '../../common/PrismicRichText.astro'

import type { ImageField, RichTextField } from '@prismicio/client'
import type { JournalItem } from '@lib/get-journal-items'
import type { NotebookPostDocument } from '@typez/generated/prismic'

interface Props {
    item: JournalItem
}

const { item } = Astro.props

function getFirstSliceImage(
    slices: NotebookPostDocument['data']['slices'],
): ImageField | undefined {
    for (const slice of slices) {
        const images =
            slice.slice_type === 'image'
                ? [slice.primary.image]
                : slice.slice_type === 'image_list'
                  ? isBoldImageList(slice)
                      ? getBoldImages(slice).map(({ image }) => image)
                      : slice.primary.images.map(({ image }) => image)
                  : []
        const image = images.find((image) => isFilled.image(image))

        if (image) {
            return image
        }
    }

    return undefined
}
const { lang } = Astro.locals

let image: ImageField
let subtitle: RichTextField | null = null
let description: RichTextField | null = null

switch (item.type) {
    case 'blog_post':
        image = item.doc.data.cover_image
        subtitle = item.doc.data.subtitle
        description = item.doc.data.short_description
        break
    case 'notebook_post':
        image =
            getFirstSliceImage(item.doc.data.slices) ?? item.doc.data.meta_image
        break
    case 'recipe':
        image = item.doc.data.meta_image
        break
}

const postTitle = getEntryTitleHtml(item.doc.data, lang)
const dateString = getJournalEntryDate(item.publicationDate, lang)
---

<li class="post" data-type={item.type}>
    {isFilled.image(image) && (
        <div>
            <Image image={image} quality={75} />
        </div>
    )}

    <div class="postText">
        <time class="postDate" datetime={item.publicationDate}>
            {dateString}
        </time>

        <a class="postTitle" href={item.href} set:html={postTitle} />

        {subtitle && (
            <PrismicRichText class="postSubtitle" richText={subtitle} />
        )}

        {description && (
            <PrismicRichText class="postDescription" richText={description} />
        )}
    </div>
</li>

<style>
    .post {
        display: grid;
        gap: var(--space-5);
    }

    .postLabel {
        color: var(--color-blue-10);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        line-height: 1;
        margin-bottom: var(--space-2);
    }

    .postDate {
        color: var(--color-ivory-9);
        display: block;
        font-size: var(--font-size-3-sc);
        font-variant-caps: normal;
        font-weight: var(--font-weight-medium);
        line-height: 1;
        margin-bottom: var(--space-5);
        text-box-edge: cap alphabetic;
        text-box-trim: trim-both;
    }

    .postTitle {
        color: var(--color-ivory-11);
        display: inline-block;
        font-size: var(--font-size-4);
        font-weight: var(--font-weight-bold);
        line-height: 1.2;
        text-box-edge: cap alphabetic;
        text-box-trim: trim-both;
        text-decoration: none;

        &:is(a):hover {
            text-decoration: underline;
            text-decoration-thickness: 1px;
        }

        &:has(+ :is(.postSubtitle, .postDescription)) {
            margin-bottom: var(--space-2);
        }
    }

    .postSubtitle {
        color: var(--color-ivory-10);
        font-size: var(--font-size-3-sc);

        &:has(+ .postDescription) {
            margin-bottom: var(--space-3);
        }
    }

    .postDescription {
        color: var(--color-ivory-12);
        font-size: var(--font-size-4);
    }

    .post[data-type='blog_post'] {
        @container featuredBlogPostsList (width > 40rem) {
            grid-template-columns: 18rem 1fr;
        }

        .postTitle {
            font-size: var(--font-size-5);
        }
    }

    .post[data-type='notebook_post'] {
        background-color: var(--color-ivory-1);
        border: 1px solid var(--color-ivory-4);
        border-radius: 2px;
        gap: var(--space-4);
        padding: var(--space-2) var(--space-2) var(--space-5);

        @container featuredBlogPostsList (width > 35rem) {
            grid-template-columns: 7rem 1fr;
            padding: var(--space-2);
        }

        .postText {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .postDate {
            margin-bottom: var(--space-4);
        }

        .postTitle {
            font-style: italic;
            font-weight: var(--font-weight-medium);
        }
    }

    .post[data-type='recipe'] {
        @container featuredBlogPostsList (width > 40rem) {
            grid-template-columns: 18rem 1fr;
        }
    }
</style>
