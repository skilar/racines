---
import Image from '../common/Image.astro'
import PrismicRichText from '../common/PrismicRichText.astro'

import type { BigTextWithImageSlice } from '@typez/generated/prismic'

interface Props {
    slice: BigTextWithImageSlice
}

const { slice } = Astro.props
---

<div class="container" data-slice-type={slice.slice_type}>
    <div class="image">
        <Image image={slice.primary.image} />
    </div>

    <div class="text">
        <PrismicRichText class="title" richText={slice.primary.title} />
        <PrismicRichText
            class="caption prose"
            richText={slice.primary.caption}
        />
    </div>
</div>

<style>
    .container {
        margin-inline: auto;
        max-width: var(--width-text);
        width: 100%;

        :global(.withSidebar) & {
            display: grid;
            grid-template-columns: var(--with-sidebar-cols);
            gap: var(--with-sidebar-gap);
            max-width: unset;
        }
    }

    .image {
        margin-bottom: var(--space-7);

        :global(.withSidebar) & {
            grid-column: var(--with-sidebar-first-col);
            margin: 0;
        }
    }

    .text {
        max-width: var(--width-text);

        :global(.withSidebar) & {
            grid-column: var(--with-sidebar-second-col);
        }
    }

    .title {
        font-size: var(--font-size-4-sc);
        font-weight: var(--font-weight-bold);

        &:has(+ .caption) {
            margin-bottom: var(--space-7);
        }
    }

    .caption {
        max-width: var(--width-text);
        width: 100%;
    }
</style>
