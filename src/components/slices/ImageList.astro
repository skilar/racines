---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'
import ZoomableImage from '../common/ZoomableImage.astro'

import type { ImageListSlice } from '@typez/generated/prismic'

interface Props {
    noteOffset?: number | undefined
    slice: ImageListSlice
    zoomOffset?: number | undefined
}

const { noteOffset, slice, zoomOffset } = Astro.props

// Make sure there are actually images in the slice
const images = slice.primary.images
    .map(({ image }) => image)
    .filter(isFilled.image)

const isVertical = slice.variation === 'vertical'
const count = Math.max(images.length, 1)
const sizes = isVertical
    ? 'auto, 100vw'
    : `auto, (min-width: 650px) calc(min(100vw, 65rem) / ${count}), 50vw`
---

<div class="container" data-slice-type={slice.slice_type}>
    {
        images.length > 0 && (
            <ul class:list={['imageList', { vertical: isVertical }]}>
                {images.map((image, index) => (
                    <li>
                        <ZoomableImage
                            class="listImage"
                            image={image}
                            quality={75}
                            sizes={sizes}
                            zoomIndex={
                                zoomOffset === undefined
                                    ? undefined
                                    : zoomOffset + index
                            }
                        />
                    </li>
                ))}
            </ul>
        )
    }
    {
        'caption' in slice.primary &&
            isFilled.richText(slice.primary.caption) && (
                <PrismicRichText
                    class="caption"
                    noteOffset={noteOffset}
                    richText={slice.primary.caption}
                />
            )
    }
</div>

<style>
    .container {
        container: imageList / inline-size;
        max-width: var(--width-image);

        :global(.withSidebar) & {
            display: grid;
            grid-template-columns: var(--with-sidebar-cols);
            gap: var(--with-sidebar-gap);
            max-width: unset;
        }
    }

    .imageList {
        display: flex;
        gap: var(--space-5);
        overflow: auto;

        &.vertical {
            flex-direction: column;
            overflow: visible;
        }

        :global(.withSidebar) & {
            grid-column: var(--with-sidebar-second-col);
        }
    }

    li {
        border: 1px solid var(--color-ivory-4);
        border-bottom: var(--double-border);
        padding: calc(var(--space-1) / 2);
    }

    .imageList:not(.vertical) li {
        flex: 0 0 50vw;
        min-width: 0;

        @container imageList (width >= 40rem) {
            flex: 1 1 0;
        }
    }

    .caption {
        color: var(--color-grey-11);
        font-size: var(--font-size-3);
        margin-inline: auto;
        margin-top: var(--space-4);
        max-width: var(--width-text);
    }
</style>
