---
import { isFilled } from '@prismicio/client'
import { fixText } from '@lib/get-fixer'
import { UI } from '@lib/i18n'
import getJournalEntryDate from '@lib/get-journal-entry-date'
import getRelationshipDate from '@lib/get-relationship-date'

import Image from '../common/Image.astro'
import PrismicRichText from '../common/PrismicRichText.astro'

import type { KeyTextField } from '@prismicio/client'
import type { BlogPostLinkSectionSlice } from '@typez/generated/prismic'

interface Props {
    slice: BlogPostLinkSectionSlice
}

const { slice } = Astro.props
const { lang } = Astro.locals

const postTitle = (title: KeyTextField) =>
    isFilled.keyText(title) ? fixText(title, lang) : UI[lang].untitledEntry
---

<div class="container" data-slice-type={slice.slice_type}>
    <div class="wrapper">
        <div>
            {
                isFilled.keyText(slice.primary.title) && (
                    <h2>{fixText(slice.primary.title, lang)}</h2>
                )
            }

            <PrismicRichText
                class="description"
                richText={slice.primary.caption}
            />

            {
                isFilled.link(slice.primary.link) &&
                    isFilled.keyText(slice.primary.link.text) && (
                        <a class="journalLink" href={slice.primary.link.url}>
                            {fixText(slice.primary.link.text, lang)} →
                        </a>
                    )
            }
        </div>

        {
            isFilled.group(slice.primary.blog_posts) && (
                <div class="blogPostsContainer">
                    <ul class="blogPosts">
                        {slice.primary.blog_posts.map((post) => {
                            if (
                                isFilled.contentRelationship(post.blog_post) &&
                                post.blog_post.data
                            ) {
                                const publishedAt = getRelationshipDate(
                                    post.blog_post,
                                )
                                const dateString = getJournalEntryDate(
                                    publishedAt,
                                    lang,
                                )

                                return (
                                    <li class="post">
                                        {isFilled.image(
                                            post.blog_post.data.cover_image,
                                        ) && (
                                            <div>
                                                <Image
                                                    class="postImage"
                                                    image={
                                                        post.blog_post.data
                                                            .cover_image
                                                    }
                                                    quality={75}
                                                />
                                            </div>
                                        )}

                                        <div class="postText">
                                            <time
                                                class="postDate"
                                                datetime={publishedAt}
                                            >
                                                {dateString}
                                            </time>

                                            {post.blog_post.url ? (
                                                <a
                                                    class="postTitle"
                                                    href={post.blog_post.url}
                                                >
                                                    {postTitle(
                                                        post.blog_post.data
                                                            .title,
                                                    )}
                                                </a>
                                            ) : (
                                                <span class="postTitle">
                                                    {postTitle(
                                                        post.blog_post.data
                                                            .title,
                                                    )}
                                                </span>
                                            )}

                                            <PrismicRichText
                                                class="postDescription"
                                                richText={
                                                    post.blog_post.data.subtitle
                                                }
                                            />
                                        </div>
                                    </li>
                                )
                            }

                            return null
                        })}
                    </ul>
                </div>
            )
        }
    </div>
</div>

<style>
    .container {
        container: featuredBlogPosts / inline-size;
    }

    .wrapper {
        border-top: var(--double-border);
        display: grid;
        gap: var(--space-5);
        margin-top: var(--space-8);
        padding-top: var(--space-6);

        @container featuredBlogPosts (width > 50rem) {
            grid-template-columns: 18rem 1fr;
        }
    }

    h2 {
        color: var(--color-blue-10);
        font-size: var(--font-size-5);
        font-variation-settings: 'opsz' 6;
        margin-bottom: var(--space-3);
        text-box-edge: cap alphabetic;
        text-box-trim: trim-both;
    }

    .description {
        font-size: var(--font-size-4);
        margin-bottom: var(--space-1);
    }

    .journalLink {
        color: var(--color-red-8);
        font-size: var(--font-size-4);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.25px;
        text-decoration: none;

        &:hover {
            text-decoration: underline;
            text-decoration-thickness: 1px;
        }
    }

    .blogPostsContainer {
        container: featuredBlogPostsList / inline-size;
    }

    .blogPosts {
        display: grid;
        gap: var(--space-5);

        @container featuredBlogPostsList (width > 40rem) {
            grid-template-columns: 1fr 1fr;
        }

        @container featuredBlogPostsList (width > 50rem) {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .post {
        display: grid;
        gap: 0;
        grid-row: auto / span 2;
        grid-template-rows: subgrid;
    }

    .postImage {
        height: 15rem;
        object-fit: cover;
    }

    .postText {
        background-color: var(--color-ivory-2);
        border-inline: 1px solid var(--color-ivory-4);
        border-bottom: 4px double var(--color-ivory-4);
        padding-block: var(--space-4) var(--space-5);
        padding-inline: var(--space-3);
    }

    .postDate {
        color: var(--color-ivory-9);
        display: block;
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        line-height: 1;
        margin-bottom: var(--space-4);
    }

    .postTitle {
        color: var(--color-red-8);
        display: inline-block;
        font-family: var(--font-headline);
        font-size: var(--font-size-4);
        font-variation-settings: 'opsz' 6;
        font-weight: var(--font-weight-bold);
        line-height: 1.2;
        text-box-edge: cap alphabetic;
        text-box-trim: trim-both;
        text-decoration: none;

        &:is(a):hover {
            text-decoration: underline;
            text-decoration-thickness: 1px;
        }

        &:has(+ .postDescription) {
            margin-bottom: var(--space-4);
        }
    }

    .postDescription {
        color: var(--color-grey-11);
        font-size: var(--font-size-3);
    }
</style>
