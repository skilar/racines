---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'

import type { TextSlice } from '@typez/generated/prismic'

interface Props {
    hasBigCap?: boolean
    noteOffset?: number | undefined
    slice: TextSlice
}

const { hasBigCap = false, noteOffset, slice } = Astro.props
---

{
    isFilled.richText(slice.primary.text) && (
        <div
            class:list={['container', { hasBigCap }]}
            data-slice-type={slice.slice_type}
        >
            <PrismicRichText
                noteOffset={noteOffset}
                richText={slice.primary.text}
            />
        </div>
    )
}

<style>
    .container {
        --post-line-height: var(--line-height-default);
        --post-text-size: var(--font-size-4);
        --post-line: calc(
            (var(--post-line-height) * var(--post-text-size)) / 2
        );

        font-size: var(--font-size-4);
        hyphens: auto;
        max-width: var(--width-text);
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
        width: 100%;

        :is(h1, h2, h3, h4, h5, h6) {
            hyphens: none;

            &:has(+ h1, + h2, + h3, + h4, + h5, + h6, + p, + ol, + ul) {
                margin-bottom: var(--post-line);
            }
        }

        :is(p, ol, ul) {
            &:has(+ h2, + h3) {
                margin-bottom: calc(var(--post-line) * 2);
            }

            &:has(+ p, + ol, + ul) {
                margin-bottom: var(--post-line);
            }
        }

        :is(li):has(+ li) {
            margin-bottom: calc(var(--post-line) / 2);
        }

        h2 {
            font-size: var(--font-size-4-sc);
        }

        h3 {
            font-variant-caps: all-small-caps;
            font-weight: 450;
            line-height: 1;
        }

        ol,
        ul {
            margin-left: calc(var(--post-line) * 3);
        }

        ol {
            list-style-type: decimal;
        }

        ul {
            list-style-type: circle;
        }
    }

    .hasBigCap {
        p:first-of-type::first-letter {
            font-size: var(--font-size-8);
            float: left;
            margin-bottom: calc(var(--space-3) * -1.5);
            margin-right: var(--space-1);
            margin-top: var(--space-2);
        }
    }
</style>
