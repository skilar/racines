---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'

import type { TextSlice } from '@typez/generated/prismic'

interface Props {
    hasBigCap?: boolean
    noteOffset?: number | undefined
    slice: TextSlice
}

const { hasBigCap = false, noteOffset, slice } = Astro.props
---

{isFilled.richText(slice.primary.text) && (
    <div
        class:list={[
            'container',
            {
                hasBigCap,
                isAside: slice.variation === 'aside',
                isPullQuote: slice.variation === 'pullQuote',
            },
        ]}
        data-slice-type={slice.slice_type}
    >
        <PrismicRichText
            class="prose textContents"
            hideLeadingQuote={hasBigCap}
            noteOffset={noteOffset}
            richText={slice.primary.text}
        />
    </div>
)}

<style>
    .container {
        max-width: var(--width-text);

        :global(.withSidebar) & {
            display: grid;
            grid-template-columns: var(--with-sidebar-cols);
            gap: var(--with-sidebar-gap);
            max-width: unset;
        }
    }

    .textContents {
        max-width: var(--width-text);
        width: 100%;

        :global(.withSidebar) & {
            grid-column: var(--with-sidebar-second-col);
        }
    }

    .hasBigCap {
        p:first-of-type::first-letter {
            font-size: var(--font-size-8);
            float: left;
            margin-bottom: calc(var(--space-3) * -1.5);
            margin-right: var(--space-1);
            margin-top: var(--space-2);

            /*
             * Chrome and Safari size a floated first letter differently, so
             * where supported let the cap sit on the line grid instead.
             */
            @supports (initial-letter: 2) or (-webkit-initial-letter: 2) {
                -webkit-initial-letter: 2;
                initial-letter: 2;
                float: none;
                font-size: inherit;
                margin: 0 var(--space-1) 0 0;
            }
        }

        /*
         * Safari drops an initial letter onto its own line when the text is
         * trimmed, so untrim it and pull in the margins by the amount the
         * cap-to-alphabetic trim would have taken off.
         */
        @supports (initial-letter: 2) or (-webkit-initial-letter: 2) {
            .textContents {
                margin-block: calc((1lh - 1cap) / -2);
                text-box-trim: none;
            }
        }
    }

    .isAside {
        background-color: var(--color-ivory-1);
        border-block: var(--double-border);
        padding-block: var(--space-7);
        padding-inline: var(--space-6);

        .textContents {
            font-size: var(--font-size-3-sc);
        }
    }

    .isPullQuote {
        border-block: var(--double-border);
        padding-block: calc(var(--space-8) * 2);
        padding-inline: var(--space-6);
        text-align: center;

        .textContents {
            font-size: var(--font-size-5);
            font-style: italic;
            font-weight: var(--font-weight-medium);
        }
    }
</style>
