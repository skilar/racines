---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'

import type { TextSlice } from '@typez/generated/prismic'

interface Props {
    hasBigCap?: boolean
    noteOffset?: number | undefined
    slice: TextSlice
}

const { hasBigCap = false, noteOffset, slice } = Astro.props
---

{isFilled.richText(slice.primary.text) && (
    <div
        class:list={[
            'container',
            {
                hasBigCap,
                isPullQuote: slice.variation === 'pullQuote',
            },
        ]}
        data-slice-type={slice.slice_type}
    >
        <PrismicRichText
            class="prose textContents"
            hideLeadingQuote={hasBigCap}
            noteOffset={noteOffset}
            richText={slice.primary.text}
        />
    </div>
)}

<style>
    .container {
        max-width: var(--width-text);

        :global(.withSidebar) & {
            display: grid;
            grid-template-columns: var(--with-sidebar-cols);
            gap: var(--with-sidebar-gap);
            max-width: unset;
        }
    }

    .textContents {
        max-width: var(--width-text);
        width: 100%;

        :global(.withSidebar) & {
            grid-column: var(--with-sidebar-second-col);
        }
    }

    .hasBigCap {
        p:first-of-type::first-letter {
            font-size: var(--font-size-8);
            float: left;
            margin-bottom: calc(var(--space-3) * -1.5);
            margin-right: var(--space-1);
            margin-top: var(--space-2);
        }
    }

    .isPullQuote {
        border-block: var(--double-border);
        padding-block: calc(var(--space-8) * 2);
        padding-inline: var(--space-6);
        text-align: center;

        .textContents {
            font-size: var(--font-size-5);
            font-style: italic;
            font-weight: var(--font-weight-medium);
        }
    }
</style>
