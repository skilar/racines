---
import { isFilled } from '@prismicio/client'

import Image from '@components/common/Image.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { ImageListSlice } from '@typez/generated/prismic'

interface Props {
    slice: ImageListSlice
}

const { slice } = Astro.props
const { images } = slice.primary

const isVertical = slice.variation === 'vertical'
const count = Math.max(
    images.filter(({ image }) => isFilled.image(image)).length,
    1,
)
const sizes = isVertical
    ? 'auto, 100vw'
    : `auto, (min-width: 650px) calc(min(100vw, 65rem) / ${count}), 50vw`
---

<div class="container" data-slice-type={slice.slice_type}>
    {
        images.length > 0 && (
            <ul class:list={['imageList', { vertical: isVertical }]}>
                {images.map(({ image }) => {
                    if (isFilled.image(image)) {
                        return (
                            <li>
                                <Image
                                    class="listImage"
                                    image={image}
                                    quality={75}
                                    sizes={sizes}
                                />
                            </li>
                        )
                    }

                    return null
                })}
            </ul>
        )
    }
    {
        'caption' in slice.primary &&
            isFilled.richText(slice.primary.caption) && (
                <PrismicRichText
                    class="caption"
                    richText={slice.primary.caption}
                />
            )
    }
</div>

<style>
    .container {
        container: imageList / inline-size;
        max-width: 60rem;
        width: 100%;
    }

    .imageList {
        display: flex;
        gap: var(--space-5);
        overflow: auto;

        &.vertical {
            flex-direction: column;
            overflow: visible;
        }
    }

    li {
        border: 1px solid var(--color-blue-10);
        border-bottom-width: 2px;
        padding: calc(var(--space-1) / 2);
    }

    .imageList:not(.vertical) li {
        flex: 0 0 50vw;
        min-width: 0;

        @container imageList (width >= 650px) {
            flex: 1 1 0;
        }
    }

    .caption {
        color: var(--color-grey-11);
        font-size: var(--font-size-3);
        margin-top: var(--space-4);
    }
</style>
