---
import { isFilled } from '@prismicio/client'

import ImageCaption from '../../common/ImageCaption.astro'
import ZoomableImage from '../../common/ZoomableImage.astro'

import type { ImageListSlice } from '@typez/generated/prismic'

interface Props {
    noteOffset?: number | undefined
    slice: Exclude<ImageListSlice, { variation: 'twoBoldImages' }>
    zoomOffset?: number | undefined
}

const { noteOffset, slice, zoomOffset } = Astro.props

const images = slice.primary.images
    .map(({ image }) => image)
    .filter(isFilled.image)
const isVertical = slice.variation === 'vertical'

const ratios = images.map(
    ({ dimensions }) => dimensions.width / dimensions.height,
)
const totalRatio = ratios.reduce((sum, ratio) => sum + ratio, 0) || 1

const getSizes = (ratio: number) =>
    isVertical
        ? 'auto, 100vw'
        : `auto, (min-width: 650px) calc(min(100vw, 60rem) * ${ratio / totalRatio}), calc(min(60vw, 22rem) * ${ratio})`
---

<div class="container" data-slice-type={slice.slice_type}>
    {images.length > 0 && (
        <ul class:list={['imageList', { vertical: isVertical }]}>
            {images.map((image, index) => (
                <li
                    style={isVertical ? undefined : `--ratio: ${ratios[index]}`}
                >
                    <ZoomableImage
                        class="listImage"
                        image={image}
                        quality={75}
                        sizes={getSizes(ratios[index] ?? 1)}
                        zoomIndex={
                            zoomOffset === undefined
                                ? undefined
                                : zoomOffset + index
                        }
                    />
                </li>
            ))}
        </ul>
    )}

    {'caption' in slice.primary && isFilled.richText(slice.primary.caption) && (
        <ImageCaption noteOffset={noteOffset} caption={slice.primary.caption} />
    )}
</div>

<style>
    .container {
        container: imageList / inline-size;
        max-width: var(--width-image);

        :global(.withSidebar) & {
            display: grid;
            grid-template-columns: var(--with-sidebar-cols);
            gap: var(--with-sidebar-gap);
            max-width: unset;
        }
    }

    .imageList {
        display: flex;
        gap: var(--space-5);
        overflow: auto;

        &.vertical {
            flex-direction: column;
            overflow: visible;
        }

        :global(.withSidebar) & {
            grid-column: var(--with-sidebar-second-col);
        }
    }

    li {
        border: 1px solid var(--color-ivory-4);
        border-bottom: var(--double-border);
        padding: calc(var(--space-1) / 2);
    }

    .imageList:not(.vertical) li {
        --strip-height: min(60vw, 22rem);

        flex: 0 0
            calc(var(--ratio, 1) * var(--strip-height) + var(--space-1) + 2px);
        min-width: 0;

        @container imageList (width >= 40rem) {
            flex: var(--ratio, 1) 1 0;
        }
    }
</style>
