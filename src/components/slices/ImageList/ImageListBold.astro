---
import { isFilled } from '@prismicio/client'
import { getBoldImages } from '@lib/bold-images'
import { countFieldNotes } from '@lib/notes'

import ImageCaption from '../../common/ImageCaption.astro'
import ZoomableImage from '../../common/ZoomableImage.astro'

import type { BoldImageListSlice } from '@lib/bold-images'

interface Props {
    noteOffset?: number | undefined
    slice: BoldImageListSlice
    zoomOffset?: number | undefined
}

const { noteOffset, slice, zoomOffset } = Astro.props

const figures = getBoldImages(slice)
const isThree = slice.variation === 'threeBoldImages'

const getNoteOffset = (index: number) =>
    noteOffset === undefined
        ? noteOffset
        : figures
              .slice(0, index)
              .reduce(
                  (offset, { caption }) => offset + countFieldNotes(caption),
                  noteOffset,
              )

const background = slice.primary.background_color.toLowerCase()
const sizes = isThree
    ? 'auto, (min-width: 960px) calc(min(100vw, 80rem) / 3), 100vw'
    : 'auto, (min-width: 650px) calc(min(100vw, 80rem) / 2), 100vw'
---

{figures.length > 0 && (
    <div
        class="container"
        data-background={background}
        data-slice-type={slice.slice_type}
        data-slice-variation={slice.variation}
    >
        <div class:list={['figures', { three: isThree }]}>
            {figures.map(({ image, caption }, index) => (
                <figure>
                    <ZoomableImage
                        class="doubleBold"
                        image={image}
                        quality={75}
                        sizes={sizes}
                        zoomIndex={
                            zoomOffset === undefined
                                ? undefined
                                : zoomOffset + index
                        }
                    />

                    {isFilled.richText(caption) && (
                        <ImageCaption
                            caption={caption}
                            noteOffset={getNoteOffset(index)}
                        />
                    )}
                </figure>
            ))}
        </div>
    </div>
)}

<style>
    .container {
        container: boldImages / inline-size;
        padding-block: calc(var(--space-9) * 2);
        padding-inline: var(--space-7);
    }

    .figures {
        display: grid;
        gap: var(--space-9);

        @container boldImages (width >= 40rem) {
            grid-template-columns: 1fr 1fr;
        }

        &.three {
            @container boldImages (width >= 40rem) {
                grid-template-columns: 1fr;
                padding-inline: var(--space-9);
            }

            @container boldImages (width >= 60rem) {
                grid-template-columns: repeat(3, 1fr);
            }
        }
    }

    figure {
        align-items: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin: 0;
    }

    .doubleBold {
        border: var(--image-border-thick);
        max-width: 25rem;
    }

    .figures :global(.caption) {
        color: inherit;
    }
</style>
