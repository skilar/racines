---
import { asHTML, isFilled } from '@prismicio/client'
import getFixer from '@lib/get-fixer'
import { noteId, noteRefId } from '@lib/notes'
import tightenNoteRefs from '@lib/tighten-note-refs'

import type { RichTextField } from '@prismicio/client'

interface Props {
    class?: string
    /**
     * Footnotes are numbered across a whole slice zone, so a field cannot know
     * where its own numbering starts. `SliceZone` counts what came before and
     * passes it in. Left out, there is no endnote list to point at, so the note
     * falls through to the default label span like any other label.
     */
    noteOffset?: number | undefined
    richText: RichTextField
}

const { class: className, noteOffset, richText, ...rest } = Astro.props
const { lang } = Astro.locals

// `asHTML` walks the tree in document order, so a running count here follows the
// order the markers appear in on the page.
let noteNumber = noteOffset ?? 0

const htmlRichText = isFilled.richText(richText)
    ? tightenNoteRefs(
          getFixer(lang).fixHtml(
              asHTML(richText, {
                  serializer: {
                      // Returning nothing falls through to Prismic's default,
                      // `<span class="{label}">`.
                      label: ({ node }) => {
                          if (
                              node.data.label !== 'footnote' ||
                              noteOffset === undefined
                          ) {
                              return
                          }

                          noteNumber += 1

                          const ref = noteRefId(noteNumber)
                          const note = noteId(noteNumber)

                          return `<a class="note-ref" id="${ref}" href="#${note}">${noteNumber}</a>`
                      },
                  },
              }),
          ),
      )
    : null
---

{htmlRichText && <div class={className} set:html={htmlRichText} {...rest} />}
