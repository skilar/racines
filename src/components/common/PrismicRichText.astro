---
import { asHTML } from '@prismicio/client'

import type { RichTextField } from '@prismicio/types'

interface Props {
    class?: string
    richText: RichTextField
}

const { class: className, richText, ...rest } = Astro.props
const htmlRichText = richText
    ? asHTML(richText, {
          serializer: {
              label: ({ node, children }) =>
                  node.data.label === 'footnote'
                      ? `<span class="sidenote-ref"></span>
                          <span class="sidenote">${children}</span>
                      </>`
                      : `<span class="${node.data.label}">${children}</span>`,
          },
      })
    : null
---

{htmlRichText && <div class={className} set:html={htmlRichText} {...rest} />}
