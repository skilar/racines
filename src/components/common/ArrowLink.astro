---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'a'> {
    caption: string
    class?: string
    description?: string | undefined
    hiddenCaption?: string | undefined
    href: string
}

const {
    caption,
    class: className,
    description,
    hiddenCaption,
    ...rest
} = Astro.props
---

<a class:list={['arrowLink', className]} {...rest}>
    {description ? (
        <span class="text">
            <span class="linkTitle">{caption}</span>
            <span class="description">{description}</span>
        </span>
    ) : (
        <span class="linkTitle">{caption}</span>
    )}

    {hiddenCaption && <span class="visuallyHidden">{hiddenCaption}</span>}

    <span class="arrow" aria-hidden="true">
        →
    </span>
</a>

<style>
    /* Set `--arrow-travel` on the link to change how far the arrow moves on
       hover. Color, size, and weight come from wherever the link is used. */
    .arrowLink {
        display: inline-flex;
        gap: var(--space-1);
        text-decoration: none;

        &:hover {
            .linkTitle {
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-1);
            }

            .arrow {
                translate: var(--arrow-travel, var(--space-1)) 0;
            }
        }
    }

    .text {
        display: grid;
        gap: var(--space-1);
    }

    .description {
        font-weight: var(--font-weight-normal);
    }

    .arrow {
        transition: translate 200ms ease-in-out;
    }
</style>
