---
import { countNotes } from '@lib/notes'
import { countZoomableImages } from '@lib/zoom'

import BigTextWithImage from '@components/slices/BigTextWithImage.astro'
import BlogPostLinkSection from '@components/slices/BlogPostLinkSection/BlogPostLinkSection.astro'
import FooterLinkSection from '@components/slices/FooterLinkSection/FooterLinkSection.astro'
import Hero from '@components/slices/Hero/Hero.astro'
import Image from '@components/slices/Image.astro'
import ImageList from '@components/slices/ImageList.astro'
import NewsletterSignupForm from '@components/slices/NewsletterSignupForm/NewsletterSignupForm.astro'
import Quote from '@components/slices/Quote.astro'
import Text from '@components/slices/Text.astro'

import type { SliceZone } from '@prismicio/client'
import type { AnySlice } from '@typez/prismic'

interface Props {
    // Controls large capital letter at beginning of text slice.
    hasBigCap?: boolean
    // Article bodies number their footnotes across the whole zone.
    numberNotes?: boolean
    slices: SliceZone<AnySlice>
    // Article bodies open their images in a full-screen viewer.
    zoomImages?: boolean
}

const {
    hasBigCap = false,
    numberNotes = false,
    slices,
    zoomImages = false,
} = Astro.props

// How many footnotes come before each slice, so that markers spread across
// several slices still read as one sequence.
let counted = 0
const noteOffsets = slices.map((slice) => {
    const offset = counted
    counted += countNotes(slice)

    return numberNotes ? offset : undefined
})

// Same kind of counting for the zoom images, so we know which image to open.
let zoomed = 0
const zoomOffsets = slices.map((slice) => {
    const offset = zoomed
    zoomed += countZoomableImages(slice)

    return zoomImages ? offset : undefined
})

// Find first text slice so, if hasBigCap is true, the first letter can be a big cap
const firstTextSliceIndex = slices.findIndex(
    (slice) => slice.slice_type === 'text',
)
---

{slices.map((slice, index) => {
    const noteOffset = noteOffsets[index]
    const zoomOffset = zoomOffsets[index]

    switch (slice.slice_type) {
        case 'big_text_with_image':
            return <BigTextWithImage slice={slice} />
        case 'blog_post_link_section':
            return <BlogPostLinkSection slice={slice} />
        case 'footer_link_section':
            return <FooterLinkSection slice={slice} />
        case 'hero':
            return <Hero slice={slice} />
        case 'image':
            return (
                <Image
                    noteOffset={noteOffset}
                    slice={slice}
                    zoomOffset={zoomOffset}
                />
            )
        case 'image_list':
            return (
                <ImageList
                    noteOffset={noteOffset}
                    slice={slice}
                    zoomOffset={zoomOffset}
                />
            )
        case 'newsletter_signup_form':
            return <NewsletterSignupForm slice={slice} />
        case 'quote':
            return <Quote slice={slice} />
        // Back matter: `Sources` renders these after the notes.
        case 'source_list':
            return null
        case 'text':
            return (
                <Text
                    hasBigCap={hasBigCap && index === firstTextSliceIndex}
                    noteOffset={noteOffset}
                    slice={slice}
                />
            )
        default:
            return null
    }
})}
