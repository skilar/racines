---
type ButtonProps = {
    as?: 'button'
    caption: string
    href?: never
    rel?: never
    target?: never
    type?: 'button' | 'submit'
}

type LinkProps = {
    as: 'link'
    caption: string
    href: string
    rel?: string | undefined
    target?: string | undefined
    type?: never
}

type Props = (ButtonProps | LinkProps) & {
    class?: string
    style?: 'primary' | 'secondary' | 'subtle'
}

const {
    as = 'button',
    caption,
    class: className,
    href,
    rel,
    target,
    type,
    ...rest
} = Astro.props
---

{
    as === 'button' ? (
        <button class:list={['button', className]} type={type} {...rest}>
            {caption}
        </button>
    ) : (
        <a
            href={href}
            rel={rel}
            target={target}
            class:list={['button', className]}
            {...rest}
        >
            {caption}
        </a>
    )
}

<style>
    .button {
        background-color: var(--color-red-8);
        color: var(--color-ivory-1);
        display: inline-block;
        font-size: var(--font-size-4);
        font-weight: var(--font-weight-bold);
        padding: var(--space-3) var(--space-4);
        text-decoration: none;
        transition:
            background-color 100ms ease,
            scale 100ms ease;

        &:active {
            scale: 0.95;
        }

        &:hover {
            background-color: var(--color-red-9);
        }
    }
</style>
