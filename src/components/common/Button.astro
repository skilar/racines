---
type ButtonProps = {
    as?: 'button'
    caption: string
    href?: never
    rel?: never
    target?: never
    type?: 'button' | 'submit'
}

type LinkProps = {
    as: 'link'
    caption: string
    href: string
    rel?: string | undefined
    target?: string | undefined
    type?: never
}

type Props = (ButtonProps | LinkProps) & {
    class?: string
    inlineWithFormField?: boolean
    size?: '3' | '4'
    style?: 'primary' | 'secondary' | 'subtle'
}

const {
    as = 'button',
    caption,
    class: className,
    href,
    inlineWithFormField,
    rel,
    size = '4',
    style = 'primary',
    target,
    type,
    ...rest
} = Astro.props

const classList = [
    'button',
    {
        inlineWithFormField,
        primary: style === 'primary',
        secondary: style === 'secondary',
        small: size === '3',
        subtle: style === 'subtle',
    },
    className,
]
---

{
    as === 'button' ? (
        <button class:list={classList} type={type} {...rest}>
            {caption}
        </button>
    ) : (
        <a
            href={href}
            rel={rel}
            target={target}
            class:list={classList}
            {...rest}
        >
            {caption}
        </a>
    )
}

<style>
    .button {
        border: 2px solid transparent;
        border-radius: 2px;
        color: var(--color-ivory-1);
        display: inline-block;
        font-size: var(--font-size-4);
        font-weight: var(--font-weight-bold);
        line-height: 1.3;
        padding: var(--space-3) var(--space-7);
        text-decoration: none;
        transition:
            background-color 100ms ease,
            border-color 100ms ease,
            scale 100ms ease;

        &:active {
            scale: 0.95;
        }

        &.primary {
            background-color: var(--color-red-8);
            border-color: var(--color-red-8);

            &:hover {
                background-color: var(--color-red-9);
                border-color: var(--color-red-9);
            }
        }

        &.secondary {
            background-color: var(--color-blue-10);
            border-color: var(--color-blue-10);

            &:hover {
                background-color: var(--color-blue-11);
                border-color: var(--color-blue-11);
            }
        }

        &.subtle {
            background-color: var(--color-ivory-3);
            border-color: var(--color-ivory-3);
            color: var(--color-ivory-12);

            &:hover {
                background-color: var(--color-ivory-4);
                border-color: var(--color-ivory-4);
            }
        }

        &.inlineWithFormField {
            padding-block: var(--input-padding-block);
        }

        &.small {
            font-size: var(--font-size-3);
        }
    }
</style>
