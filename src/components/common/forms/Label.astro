---
import { UI } from '@lib/i18n'

import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'label'> {
    caption: string
    for: string
    isVisuallyHidden?: boolean
    required?: boolean
    size?: '3' | '4'
}

const {
    caption,
    for: htmlFor,
    isVisuallyHidden = false,
    required = false,
    size = '4',
    ...rest
} = Astro.props
const { lang } = Astro.locals
---

<label
    class:list={[
        {
            small: size === '3',
            visuallyHidden: isVisuallyHidden,
        },
    ]}
    for={htmlFor}
    {...rest}
>
    {caption} {!required && <span class="optional">({UI[lang].optional})</span>}
</label>

<style>
    label {
        color: var(--color-ivory-10);
        display: block;
        font-size: var(--font-size-3-sc);
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.25px;
        margin-bottom: var(--space-1);

        &.small {
            font-size: var(--font-size-3);
        }
    }

    .optional {
        color: var(--color-ivory-9);
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-normal);
        margin-left: var(--space-2);
    }
</style>
