---
import type { HTMLAttributes } from 'astro/types'

import Label from './Label.astro'

interface Props extends HTMLAttributes<'input'> {
    label: string
    name: string
}

const { id, label, name, ...rest } = Astro.props

const inputId = id ?? name
---

<div class="inputWrapper">
    <Label caption={label} for={inputId} />
    <input id={inputId} name={name} {...rest} />
</div>

<style>
    .inputWrapper {
        width: 100%;
    }

    input {
        appearance: none;
        background-color: var(--color-white);
        border: 2px solid var(--color-ivory-5);
        border-radius: 2px;
        box-sizing: border-box;
        display: block;
        font-family: var(--font-serif);
        font-size: var(--font-size-4);
        font-smoothing: antialiased;
        line-height: 1.3;
        margin: 0;
        max-width: 100%;
        padding-block: var(--space-1);
        padding-inline: var(--space-2);
        transition: all 200ms ease;
        width: 100%;

        &:hover {
            border-color: var(--color-ivory-6);
        }

        &:focus,
        &:focus-visible {
            border-color: var(--color-blue-9);
            outline: 0;
        }

        &::placeholder {
            color: var(--color-ivory-6);
        }
    }
</style>
