---
import type { HTMLAttributes } from 'astro/types'

import Label from './Label.astro'

interface Props extends HTMLAttributes<'input'> {
    class?: string
    hideLabel?: boolean
    label: string
    name: string
    required?: boolean
    size?: '3' | '4'
}

const {
    class: className,
    hideLabel = false,
    id,
    label,
    name,
    required = false,
    size = '4',
    type,
    ...rest
} = Astro.props

const inputId = id ?? name
---

<div
    class:list={[
        'inputWrapper',
        { small: size === '3', visuallyHidden: type === 'hidden' },
        className,
    ]}
>
    <Label
        caption={label}
        for={inputId}
        isVisuallyHidden={hideLabel}
        required={required}
        size={size}
    />
    <input id={inputId} name={name} required={required} type={type} {...rest} />
</div>

<style>
    .inputWrapper {
        width: 100%;

        &.visuallyHidden {
            width: 1px;
        }
    }

    input {
        appearance: none;
        background-color: var(--color-white);
        border: 1px solid var(--color-ivory-5);
        border-radius: 2px;
        box-sizing: border-box;
        display: block;
        font-family: var(--font-serif);
        font-size: var(--font-size-4);
        font-smoothing: antialiased;
        line-height: 1.3;
        margin: 0;
        max-width: 100%;
        padding-block: var(--input-padding-block);
        padding-inline: var(--space-2);
        transition: all 200ms ease;
        width: 100%;

        &:hover {
            border-color: var(--color-ivory-6);
        }

        &:focus,
        &:focus-visible {
            border-color: var(--color-blue-9);
            outline: 3px solid var(--color-blue-4);
        }

        &::placeholder {
            color: var(--color-ivory-6);
        }

        .small & {
            font-size: var(--font-size-3);
        }
    }
</style>
