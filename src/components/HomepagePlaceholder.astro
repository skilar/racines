---
import { client } from '@lib/prismic'

import Layout from '@layouts/Layout.astro'
import LangSelector from '@layouts/LangSelector.astro'
import PrismicRichText from './common/PrismicRichText.astro'
import Hero from './slices/Hero/Hero.astro'

import type { Lang } from '@lib/constants'

interface Props {
    lang?: Lang
}

const { lang = 'en-us' } = Astro.props

const page = await client.getSingle('temp_homepage', { lang })
---

<Layout
    description={page.data.meta_description}
    lang={lang}
    title={page.data.meta_title}
>
    <div class="container">
        <header>
            <div class="lang">
                <LangSelector />
            </div>

            <h1 class="title">{page.data.title}</h1>
            <PrismicRichText class="subtitle" richText={page.data.subtitle} />

            <div class="description">
                <PrismicRichText richText={page.data.description} />
            </div>
        </header>

        <main id="main">
            {
                page.data.slices.map((slice) => {
                    switch (slice.slice_type) {
                        case 'hero':
                            return <Hero slice={slice} />
                        default:
                            return null
                    }
                })
            }
        </main>
    </div>
</Layout>

<style>
    .container {
        --padding-block: calc(var(--space-9) * 2);
        align-items: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin-inline: auto;
        max-width: var(--text-max-width);
        min-height: 100dvh;
        padding-block: var(--padding-block);
        width: 100%;
    }

    header {
        --header-spacing: var(--space-8);
        padding-bottom: var(--padding-block);
        text-align: center;
    }

    .lang {
        margin-bottom: var(--space-5);
        text-align: center;
    }

    .title {
        border-bottom: 4px double var(--color-blue-10);
        color: var(--color-blue-10);
        display: inline-block;
        font-family: var(--font-headline);
        font-size: var(--font-size-7);
        font-weight: var(--font-weight-bold);
        font-variation-settings: 'opsz' 10;
        letter-spacing: 2px;
        margin-bottom: var(--header-spacing);
        padding-bottom: var(--space-3);
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
    }

    .subtitle {
        font-size: var(--font-size-4);
        font-variant-caps: all-small-caps;
        letter-spacing: 2px;
        line-height: 1.2;

        p:has(+ p) {
            margin-bottom: var(--header-spacing);
        }

        strong {
            color: var(--color-blue-10);
            display: inline-block;
            font-family: var(--font-headline);
            font-size: var(--font-size-5);
            font-variant-caps: normal;
            font-variation-settings: 'opsz' 6;
            font-weight: var(--font-weight-heavy);
            letter-spacing: 1px;
            margin-top: var(--space-1);
        }
    }

    .description {
        font-size: var(--font-size-3);
        margin-top: var(--header-spacing);

        p:has(+ p) {
            margin-bottom: var(--space-5);
        }
    }
</style>
