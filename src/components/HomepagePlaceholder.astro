---
import { client } from '@lib/prismic'

import Layout from '@layouts/Layout.astro'
import LangSelector from '@layouts/LangSelector.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { Lang } from '@lib/constants'

interface Props {
    lang?: Lang
}

const { lang = 'en-us' } = Astro.props

const page = await client.getSingle('temp_homepage', { lang })
---

<Layout
    description={page.data.meta_description}
    lang={lang}
    title={page.data.meta_title}
>
    <div class="container">
        <header>
            <h1 class="title">{page.data.title}</h1>
            <PrismicRichText class="subtitle" richText={page.data.subtitle} />
        </header>

        <main>
            <div class="description">
                <PrismicRichText richText={page.data.description} />
            </div>

            <LangSelector />
        </main>
    </div>
</Layout>

<style>
    .container {
        align-items: center;
        display: flex;
        flex-direction: column;
        height: 100dvh;
        justify-content: center;
        margin-inline: auto;
        max-width: var(--text-max-width);
        padding-block: var(--space-9);
        text-align: center;
        width: 100%;
    }

    .title {
        border-bottom: 4px double var(--color-blue-10);
        color: var(--color-blue-10);
        display: inline-block;
        font-family: var(--font-headline);
        font-size: var(--font-size-7);
        font-weight: var(--font-weight-bold);
        font-variation-settings: 'opsz' 10;
        letter-spacing: 2px;
        margin-bottom: var(--space-8);
        padding-bottom: var(--space-3);
        text-box-trim: trim-both;
        text-box-edge: cap alphabetic;
    }

    .description,
    .subtitle {
        font-variation-settings: 'opsz' 6;
    }

    .subtitle {
        font-size: var(--font-size-4);
        font-variant-caps: all-small-caps;
        letter-spacing: 2px;
        line-height: 1.2;

        p:has(+ p) {
            margin-bottom: var(--space-8);
        }

        strong {
            color: var(--color-blue-10);
            display: inline-block;
            font-family: var(--font-headline);
            font-size: var(--font-size-5);
            font-variant-caps: normal;
            font-weight: var(--font-weight-heavy);
            letter-spacing: 1px;
            margin-top: var(--space-1);
        }
    }

    main {
        margin-top: var(--space-9);
    }

    .description {
        font-size: var(--font-size-3);
        margin-bottom: var(--space-5);

        p:has(+ p) {
            margin-bottom: var(--space-5);
        }
    }
</style>
