---
import { client } from '@lib/prismic'

import Layout from '@layouts/Layout.astro'
import LangSelector from '@layouts/LangSelector.astro'
import PrismicRichText from './common/PrismicRichText.astro'
import SliceZone from './common/SliceZone.astro'

import type { Lang } from '@lib/constants'

interface Props {
    lang?: Lang
}

const { lang = 'en-us' } = Astro.props

const page = await client.getSingle('temp_homepage', { lang })
---

<Layout
    description={page.data.meta_description}
    lang={lang}
    title={page.data.meta_title}
>
    <div class="container">
        <div class="lang">
            <LangSelector />
        </div>

        <div class="wrapper">
            <header>
                <PrismicRichText
                    class="subtitle"
                    richText={page.data.subtitle}
                />

                <div class="description">
                    <PrismicRichText richText={page.data.description} />
                </div>
            </header>

            <main id="main">
                <SliceZone slices={page.data.slices} />
            </main>
        </div>
    </div>
</Layout>

<style>
    .container {
        --padding-block: calc(var(--space-8) * 2);
        --padding-inline: var(--space-5);

        @media (width > 650px) {
            --padding-block: calc(var(--space-9) * 2);
        }
    }

    .lang {
        margin-inline: var(--padding-inline);
        margin-top: var(--space-2);
        position: absolute;
        right: 0;

        @media (width > 650px) {
            margin-top: var(--space-5);
        }
    }

    .wrapper {
        align-items: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        margin-inline: auto;
        min-height: 100dvh;
        padding-block: var(--padding-block);
        padding-inline: var(--padding-inline);
        width: 100%;
    }

    header {
        --header-spacing: var(--space-8);
        max-width: var(--text-max-width);
        padding-bottom: var(--padding-block);
        text-align: center;
    }

    .subtitle {
        font-size: var(--font-size-4);
        font-variant-caps: all-small-caps;
        letter-spacing: 2px;
        line-height: 1.2;

        p:has(+ p) {
            margin-bottom: var(--header-spacing);
        }

        strong {
            color: var(--color-blue-10);
            display: inline-block;
            font-family: var(--font-headline);
            font-size: var(--font-size-6);
            font-variant-caps: normal;
            font-variation-settings: 'opsz' 6;
            font-weight: var(--font-weight-heavy);
            letter-spacing: 1px;
            margin-top: var(--space-4);
            text-box-edge: cap alphabetic;
            text-box-trim: trim-both;
        }
    }

    .description {
        font-size: var(--font-size-3);
        margin-top: var(--header-spacing);

        p:has(+ p) {
            margin-bottom: var(--space-5);
        }
    }

    main {
        align-items: center;
        align-self: stretch;
        display: flex;
        flex-direction: column;

        :is([data-slice-type='image_list'], [data-slice-type='hero']):has(
            + :is([data-slice-type='image_list'], [data-slice-type='hero'])
        ) {
            margin-bottom: var(--space-9);
        }
    }
</style>
