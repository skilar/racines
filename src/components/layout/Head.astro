---
import { Font } from 'astro:assets'
import { getOgLangs } from '@lib/get-og-langs'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const {
    description,
    lang,
    ogImage,
    ogImageAlt,
    title = 'Racines',
} = Astro.props

const BASE_URL = Astro.site?.toString() || 'http://www.agathegiraud.com/'
const ogUrl = new URL(Astro.url.pathname, BASE_URL).toString()
const { currentLang, otherLangs } = getOgLangs(lang)
---

<head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />

    <Font cssVariable="--font-bodoni" preload />
    <Font cssVariable="--font-garamond" preload />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={currentLang} />
    {
        otherLangs.map((lang) => (
            <meta property="og:locale:alternate" content={lang} />
        ))
    }
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
</head>
