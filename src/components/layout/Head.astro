---
import { Font } from 'astro:assets'
import { SITE_NAME } from '@lib/constants'
import { getOgLocales } from '@lib/i18n'
import { resolveRoute } from '@lib/prismic-link-resolver'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const { description, ogImage, ogImageAlt, title } = Astro.props
const { lang } = Astro.locals

const BASE_URL = Astro.site?.toString() || 'http://www.agathegiraud.com/'
const ogUrl = new URL(Astro.url.pathname, BASE_URL).toString()
const { current, alternates } = getOgLocales(lang)

const isHome = Astro.url.pathname === resolveRoute({ lang, type: 'homepage' })
const ogTitle = title || SITE_NAME
const documentTitle = title && !isHome ? `${title} - ${SITE_NAME}` : ogTitle
---

<head>
    <meta charset="utf-8" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />

    <Font cssVariable="--font-garamond" preload />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={current} />
    {
        alternates.map((locale) => (
            <meta property="og:locale:alternate" content={locale} />
        ))
    }
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
</head>
