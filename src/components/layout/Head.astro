---
import { Font } from 'astro:assets'
import { isFilled } from '@prismicio/client'
import { SITE_NAME } from '@lib/constants'
import { getAlternateHrefs } from '@lib/get-lang-links'
import { DEFAULT_LANG, LANGS, LOCALES, feedPath, getOgLocales } from '@lib/i18n'
import { resolveRoute } from '@lib/prismic-link-resolver'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const {
    alternateLanguages,
    description,
    modifiedTime,
    ogImage,
    ogImageAlt,
    ogType = 'website',
    publishedTime,
    title,
} = Astro.props
const { lang } = Astro.locals

const BASE_URL = Astro.site?.toString() ?? 'https://www.agathegiraud.com/'
const absolute = (path: string) => new URL(path, BASE_URL).toString()

const canonical = absolute(Astro.url.pathname)
const { current, alternates } = getOgLocales(lang)

// Autodiscover the user's current locale when suggesting an RSS feed.
const feeds = [lang, ...LANGS.filter((l) => l !== lang)].map((l) => ({
    href: feedPath(l),
    title: `${SITE_NAME} (${LOCALES[l].label})`,
}))

// This page, its translations, and `x-default` for the default locale's
// version (or this page when it has no translation there).
const self = { hreflang: LOCALES[lang].bcp47, href: canonical }
const translations = getAlternateHrefs(alternateLanguages, lang).map((alt) => ({
    hreflang: LOCALES[alt.lang].bcp47,
    href: absolute(alt.href),
}))
const defaultVersion =
    [self, ...translations].find(
        (link) => link.hreflang === LOCALES[DEFAULT_LANG].bcp47,
    ) ?? self
const hreflangs = [
    self,
    ...translations,
    { hreflang: 'x-default', href: defaultVersion.href },
]

const isHome = Astro.url.pathname === resolveRoute({ lang, type: 'homepage' })
const ogTitle = isFilled.keyText(title) ? title : SITE_NAME
const documentTitle = isHome ? ogTitle : `${ogTitle} - ${SITE_NAME}`
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {
        hreflangs.map((link) => (
            <link rel="alternate" hreflang={link.hreflang} href={link.href} />
        ))
    }

    <link rel="sitemap" href="/sitemap-index.xml" />
    {
        feeds.map((feed) => (
            <link
                rel="alternate"
                type="application/rss+xml"
                title={feed.title}
                href={feed.href}
            />
        ))
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Font cssVariable="--font-garamond" preload />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={current} />
    {
        alternates.map((locale) => (
            <meta property="og:locale:alternate" content={locale} />
        ))
    }
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {
        ogType === 'article' && publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
        )
    }
    {
        ogType === 'article' && modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
        )
    }
</head>
