---
import { Font } from 'astro:assets'
import { isFilled } from '@prismicio/client'
import { SITE_NAME } from '@lib/constants'
import { LANGS, LOCALES, getOgLocales } from '@lib/i18n'
import { resolveRoute } from '@lib/prismic-link-resolver'

import type { LayoutProps } from '@typez/types'

type Props = LayoutProps

const { description, ogImage, ogImageAlt, title } = Astro.props
const { lang } = Astro.locals

const BASE_URL = Astro.site?.toString() ?? 'https://www.agathegiraud.com/'
const absolute = (path: string) => new URL(path, BASE_URL).toString()

const canonical = absolute(Astro.url.pathname)
const { current, alternates } = getOgLocales(lang)

// Autodiscover the user's current locale.
const feeds = [lang, ...LANGS.filter((l) => l !== lang)].map((l) => ({
    href: `/feed-${l.replace('-', '_')}.xml`,
    title: `${SITE_NAME} (${LOCALES[l].label})`,
}))

const isHome = Astro.url.pathname === resolveRoute({ lang, type: 'homepage' })
const ogTitle = isFilled.keyText(title) ? title : SITE_NAME
const documentTitle = isHome ? ogTitle : `${ogTitle} - ${SITE_NAME}`
---

<head>
    <meta charset="utf-8" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    {
        feeds.map((feed) => (
            <link
                rel="alternate"
                type="application/rss+xml"
                title={feed.title}
                href={feed.href}
            />
        ))
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />

    <Font cssVariable="--font-garamond" preload />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:locale" content={current} />
    {
        alternates.map((locale) => (
            <meta property="og:locale:alternate" content={locale} />
        ))
    }
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
</head>
