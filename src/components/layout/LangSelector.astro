---
import { getLangLinks } from '@lib/get-lang-links'

import type { AlternateLanguage } from '@prismicio/client'

interface Props {
    alternateLanguages?: AlternateLanguage[] | undefined
}

const { alternateLanguages } = Astro.props
const { lang } = Astro.locals

const links = getLangLinks({
    alternateLanguages,
    currentPath: Astro.url.pathname,
    lang,
})
---

<ul class="langs">
    {
        links.map((link, index) => (
            <Fragment>
                {index > 0 && <li>/</li>}
                <li>
                    <a
                        class:list={[{ selected: link.selected }]}
                        href={link.href}
                    >
                        {link.label}
                    </a>
                </li>
            </Fragment>
        ))
    }
</ul>

<style>
    .langs {
        --text-color: var(--color-blue-10);
        color: var(--text-color);
        display: inline-flex;
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-medium);
        gap: var(--space-3);
        justify-content: end;
        z-index: 1000;

        a {
            color: var(--text-color);
            text-decoration: none;

            &.selected,
            &:hover {
                text-decoration: underline;
                text-decoration-color: var(--color-red-8);
                text-decoration-thickness: var(--underline-thickness-2);
            }
        }
    }
</style>
