---
import { getLangLinks } from '@lib/get-lang-links'

import type { AlternateLanguage } from '@prismicio/client'

interface Props {
    alternateLanguages?: AlternateLanguage[] | undefined
    style?: 'inline' | 'hangtag'
}

const { alternateLanguages, style = 'inline' } = Astro.props
const { lang } = Astro.locals

const links = getLangLinks({
    alternateLanguages,
    currentPath: Astro.url.pathname,
    lang,
})
---

<div
    class:list={[
        'langSelector',
        {
            hangtag: style === 'hangtag',
        },
    ]}
>
    <ul class="langs" id="langList">
        {
            links.map((link, index) => (
                <Fragment>
                    {index > 0 && <li class="divider">/</li>}
                    <li>
                        <a
                            aria-current={link.selected ? 'page' : undefined}
                            class:list={[{ selected: link.selected }]}
                            href={link.href}
                            hreflang={link.bcp47}
                            lang={link.bcp47}
                        >
                            {link.label}
                        </a>
                    </li>
                </Fragment>
            ))
        }
    </ul>
</div>

<style>
    .langSelector {
        --font-size: var(--font-size-3-sc);
        --justify-content: start;
        --text-color: var(--header-text-color);
        --text-decoration-color: var(--header-text-color);
        --text-decoration-thickness: var(--underline-thickness-2);

        display: flex;
        justify-content: var(--justify-content);
        position: relative;
        z-index: 1100;

        @container (width > 55rem) {
            --justify-content: end;
        }

        &.hangtag {
            --font-size: var(--font-size-3);
            --hangtag-bg-color: var(--color-ivory-1);
            --text-color: var(--color-red-10);
            --text-decoration-color: var(--color-red-10);
            --text-decoration-thickness: var(--underline-thickness-1);

            background-color: var(--hangtag-bg-color);
            left: var(--space-6);
            padding-block: var(--space-2);
            padding-inline: var(--space-3);
            position: absolute;
            top: 0;

            @container (width > 55rem) {
                --hangtag-bg-color: var(--color-red-10);
                --text-color: var(--color-ivory-1);
                --text-decoration-color: var(--color-ivory-1);
            }

            .langs a {
                font-weight: var(--font-weight-bold);
            }
        }
    }

    .langs {
        color: var(--text-color);
        display: flex;
        font-size: var(--font-size);
        font-weight: var(--font-weight-medium);
        gap: var(--space-3);

        a {
            color: var(--text-color);
            text-decoration: none;

            &.selected,
            &:hover {
                text-decoration: underline;
                text-decoration-color: var(--text-decoration-color);
                text-decoration-thickness: var(--text-decoration-thickness);
            }
        }
    }
</style>
