---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'
import SliceZone from '../common/SliceZone.astro'

import type { LayoutDocument } from '@typez/generated/prismic'

interface Props {
    slices: LayoutDocument['data']['slices1']
    text: LayoutDocument['data']['text']
}

const { slices, text } = Astro.props
---

{
    isFilled.richText(text) && (
        <footer>
            <div class="footer contained">
                <PrismicRichText richText={text} />

                <SliceZone slices={slices} />
            </div>
        </footer>
    )
}

<style>
    footer {
        background-color: var(--color-ivory-3);
    }

    .footer {
        align-items: center;
        display: flex;
        gap: var(--space-3);
        justify-content: center;
        padding-block: var(--space-5);
    }
</style>
