---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'
import SliceZone from '../common/SliceZone.astro'

import type { LayoutDocument } from '@typez/generated/prismic'

interface Props {
    legal: LayoutDocument['data']['legal']
    slices: LayoutDocument['data']['slices1']
}

const { slices, legal } = Astro.props
---

{
    isFilled.richText(legal) && (
        <footer>
            <div class="footer contained">
                <div class="footerSlices">
                    <SliceZone slices={slices} />
                </div>

                <div class="legal">
                    <PrismicRichText richText={legal} />
                </div>
            </div>
        </footer>
    )
}

<style>
    footer {
        background-color: var(--color-ivory-2);
        container: footer / inline-size;
    }

    .footer {
        padding-block: var(--space-6);

        @container footer (width > 60rem) {
            padding-block: var(--space-7);
        }
    }

    .footerSlices {
        display: grid;
        gap: var(--space-5);
        grid-template-columns: 1fr 1fr;

        @container footer (width > 45rem) {
            gap: var(--space-7);
            grid-template-columns: repeat(4, 1fr);
        }

        @container footer (width > 60rem) {
            gap: var(--space-5);
            grid-template-columns: 1fr 1fr 3fr 2fr;
        }
    }

    .legal {
        margin-top: var(--space-7);

        ul {
            display: flex;
            flex-direction: column;
            gap: var(--space-3);

            @container footer (width > 35rem) {
                flex-direction: row;
                flex-wrap: wrap;
                gap: var(--space-5);
            }
        }
    }
</style>
