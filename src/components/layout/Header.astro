---
import { isFilled } from '@prismicio/client'
import { fixText } from '@lib/get-fixer'
import { resolveRoute } from '@lib/prismic-link-resolver'

import PrismicRichText from '../common/PrismicRichText.astro'
import LangSelector from './LangSelector.astro'
import Nav from './Nav.astro'

import type { LayoutDocument } from '@typez/generated/prismic'
import type { LayoutProps } from '@typez/types'

interface Props {
    alternateLanguages: LayoutProps['alternateLanguages']
    menu: LayoutDocument['data']['menu']
    subtitle: LayoutDocument['data']['subtitle']
    title: LayoutDocument['data']['title']
}

const { alternateLanguages, menu, subtitle, title } = Astro.props
const { lang } = Astro.locals

const homeHref = resolveRoute({ lang, type: 'homepage' })
---

<header>
    <div class="header contained">
        <Nav alternateLanguages={alternateLanguages} menu={menu} />

        <div class="logo">
            {
                isFilled.keyText(title) && (
                    <a class="title" href={homeHref}>
                        {fixText(title, lang)}
                    </a>
                )
            }

            <PrismicRichText class="subtitle" richText={subtitle} />
        </div>

        <div class="desktopLangSelector">
            <LangSelector alternateLanguages={alternateLanguages} />
        </div>
    </div>
</header>

<style>
    header {
        --header-text-color: var(--color-ivory-1);
        background-color: var(--color-red-10);

        :global(.navIsOpen) & {
            --header-text-color: var(--color-red-10);
        }
    }

    .header {
        align-items: center;
        container: header / inline-size;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        padding-block: var(--space-5);
    }

    .logo {
        text-align: center;
        text-wrap: nowrap;
        z-index: 1000;
    }

    .title {
        color: var(--header-text-color);
        font-family: var(--font-serif);
        font-size: var(--font-size-5);
        font-weight: var(--font-weight-bold);
        letter-spacing: 1px;
        line-height: 1;
        margin-bottom: 0;
        text-decoration: none;

        &:hover {
            text-decoration: underline;
            text-decoration-thickness: var(--underline-thickness-1);
        }
    }

    .subtitle {
        color: var(--header-text-color);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        letter-spacing: 1px;
    }

    .desktopLangSelector {
        display: none;

        @container header (width > 55rem) {
            display: block;
        }
    }
</style>
