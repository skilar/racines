---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '../common/PrismicRichText.astro'
import LangSelector from './LangSelector.astro'
import Nav from './Nav.astro'

import type { LayoutDocument } from '@typez/generated/prismic'
import type { LayoutProps } from '@typez/types'

interface Props {
    alternateLanguages: LayoutProps['alternateLanguages']
    lang: LayoutProps['lang']
    menu: LayoutDocument['data']['menu']
    subtitle: LayoutDocument['data']['subtitle']
    title: LayoutDocument['data']['title']
}

const { alternateLanguages, lang, menu, subtitle, title } = Astro.props
---

<header class="contained">
    <div class="left">
        <div>
            {
                isFilled.keyText(title) && (
                    <a class="title" href="/">
                        {title}
                    </a>
                )
            }

            <PrismicRichText class="subtitle" richText={subtitle} />
        </div>

        <Nav menu={menu} />
    </div>

    <LangSelector alternateLanguages={alternateLanguages} lang={lang} />
</header>

<style>
    header {
        align-items: center;
        border-bottom: var(--double-border);
        display: flex;
        justify-content: space-between;
        max-width: var(--width-wide);
        padding-bottom: var(--space-2);
        padding-top: var(--space-4);
        padding-block: var(--space-5);
    }

    .left {
        align-items: center;
        display: flex;
        gap: var(--space-7);
    }

    .title {
        color: var(--color-blue-10);
        font-family: var(--font-headline);
        font-size: var(--font-size-5);
        font-variant-caps: all-small-caps;
        font-variation-settings: 'opsz' 10;
        font-weight: var(--font-weight-medium);
        letter-spacing: 1px;
        line-height: 1;
        margin-bottom: 0;
        text-decoration: none;

        &:hover {
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 4px;
        }
    }

    .subtitle {
        color: var(--color-red-10);
        font-size: var(--font-size-3);
        font-variant-caps: all-small-caps;
        letter-spacing: 1px;
    }
</style>
