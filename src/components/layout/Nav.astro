---
import { UI } from '@lib/i18n'
import { getNavLinks } from '@lib/prismic-link-resolver'

import LangSelector from './LangSelector.astro'

import type { AlternateLanguage } from '@prismicio/client'
import type { LayoutDocument } from '@typez/generated/prismic'

interface Props {
    alternateLanguages?: AlternateLanguage[] | undefined
    menu: LayoutDocument['data']['menu']
}

const { alternateLanguages, menu } = Astro.props
const { lang } = Astro.locals

const links = getNavLinks(menu, { currentPath: Astro.url.pathname, lang })
---

{
    links.length > 0 && (
        <nav>
            <button
                aria-controls="topNav"
                aria-expanded="false"
                class="menuToggle"
                id="menuButton"
                type="button"
            >
                <span class="visuallyHidden">{UI[lang].menu}</span>
            </button>

            <div class="navContainer" id="topNav">
                <div class="nav">
                    <ul class="navList">
                        {links.map(({ ariaCurrent, attrs, label }) => (
                            <li>
                                <a
                                    {...attrs}
                                    aria-current={ariaCurrent}
                                    class:list={[
                                        { selected: ariaCurrent !== undefined },
                                    ]}
                                >
                                    {label}
                                </a>
                            </li>
                        ))}
                    </ul>

                    <div class="navLangSelector">
                        <LangSelector alternateLanguages={alternateLanguages} />
                    </div>
                </div>
            </div>
        </nav>
    )
}

<style is:global>
    .menuToggle {
        appearance: none;
        height: 2rem;
        padding: 0;
        position: relative;
        z-index: 1000;

        &::after,
        &::before {
            background-color: var(--header-text-color);
            content: '';
            display: block;
            height: 0.125rem;
            transition: rotate 100ms ease;
            width: 2rem;
        }

        &::before {
            margin-bottom: 0.35rem;
        }

        .navIsOpen & {
            &::after {
                rotate: -45deg;
            }

            &::before {
                margin-bottom: -0.125rem;
                rotate: 45deg;
            }
        }

        @container header (width > 55rem) {
            display: none;
        }
    }

    .navContainer {
        display: none;

        .navIsOpen & {
            background-color: var(--color-ivory-3);
            display: flex;
            inset: 0;
            overscroll-behavior: contain;
            position: fixed;
            z-index: 900;
        }

        @container header (width > 55rem) {
            display: block;
        }
    }

    .nav {
        .navIsOpen & {
            border-top: 2px solid var(--color-ivory-2);
            margin-top: 6.678rem;
            overflow: auto;
            padding: var(--space-6);
            padding-top: 2rem;
            width: 100%;
        }
    }

    .navList {
        a {
            color: var(--header-text-color);
            font-size: var(--font-size-3-sc);
            font-weight: var(--font-weight-medium);
            text-decoration: none;

            &.selected,
            &:hover {
                text-decoration: underline;
                text-decoration-color: var(--header-text-color);
                text-decoration-thickness: var(--underline-thickness-2);
            }
        }

        .navIsOpen & {
            display: flex;
            flex-direction: column;
            gap: var(--space-4);

            a {
                font-size: var(--font-size-6);

                &.selected,
                &:hover {
                    text-decoration-thickness: var(--underline-thickness-3);
                    text-underline-offset: var(--underline-offset-2);
                }
            }
        }

        @container header (width > 55rem) {
            display: flex;
            gap: var(--space-5);
        }
    }

    .navLangSelector {
        display: none;
        margin-top: var(--space-7);

        .navIsOpen & {
            display: block;
        }
    }

    .navIsOpen {
        height: 100%;
        overflow: hidden;
    }
</style>

<script>
    const button = document.querySelector<HTMLButtonElement>('#menuButton')
    const doc = document.documentElement
    const nav = document.querySelector<HTMLElement>('#topNav')
    const className = 'navIsOpen'

    const isOpen = () => doc.classList.contains(className)

    const setOpen = (open: boolean) => {
        doc.classList.toggle(className, open)
        button?.setAttribute('aria-expanded', String(open))
    }

    button?.addEventListener('click', () => {
        const open = !isOpen()

        nav?.animate([{ opacity: open ? 0 : 1 }, { opacity: open ? 1 : 0 }], {
            duration: 100,
        })

        setOpen(open)
    })

    doc.addEventListener('keyup', (event) => {
        if (event.key === 'Escape' && isOpen()) {
            setOpen(false)
        }
    })
</script>
