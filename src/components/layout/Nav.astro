---
import { UI } from '@lib/i18n'
import { getNavLinks } from '@lib/prismic-link-resolver'

import type { LayoutDocument } from '@typez/generated/prismic'

interface Props {
    menu: LayoutDocument['data']['menu']
}

const { menu } = Astro.props
const { lang } = Astro.locals

const links = getNavLinks(menu, { currentPath: Astro.url.pathname, lang })
---

{
    links.length > 0 && (
        <nav>
            <button class="menuToggle" id="menuButton">
                <span class="visuallyHidden">{UI[lang].menu}</span>
            </button>

            <div class="navContainer" id="topNav">
                <ul class="nav">
                    {links.map(({ ariaCurrent, attrs, label }) => (
                        <li>
                            <a
                                {...attrs}
                                aria-current={ariaCurrent}
                                class:list={[
                                    { selected: ariaCurrent !== undefined },
                                ]}
                            >
                                {label}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </nav>
    )
}

<style is:global>
    .menuToggle {
        appearance: none;
        height: 2rem;
        padding: 0;
        position: relative;
        z-index: 1000;

        &::after,
        &::before {
            background-color: var(--color-blue-10);
            content: '';
            display: block;
            height: 0.125rem;
            transition: rotate 100ms ease;
            width: 2rem;
        }

        &::before {
            margin-bottom: 0.35rem;
        }

        .navIsOpen & {
            &::after {
                rotate: -45deg;
            }

            &::before {
                margin-bottom: -0.125rem;
                rotate: 45deg;
            }
        }

        @container header (width > 55rem) {
            display: none;
        }
    }

    .navContainer {
        display: none;

        .navIsOpen & {
            background-color: var(--color-ivory-3);
            display: flex;
            inset: 0;
            overscroll-behavior: contain;
            position: fixed;
            z-index: 900;
        }

        @container header (width > 55rem) {
            display: block;
        }
    }

    .nav {
        a {
            color: var(--color-blue-10);
            font-size: var(--font-size-3);
            font-weight: var(--font-weight-medium);
            text-decoration: none;

            &.selected,
            &:hover {
                text-decoration: underline;
                text-decoration-color: var(--color-red-8);
                text-decoration-thickness: var(--underline-thickness-2);
            }
        }

        .navIsOpen & {
            border-top: 2px solid var(--color-ivory-2);
            display: flex;
            flex-direction: column;
            gap: var(--space-4);
            margin-top: 6.678rem;
            padding: var(--space-6);
            padding-top: 2rem;
            width: 100%;

            a {
                font-size: var(--font-size-6);

                &.selected,
                &:hover {
                    text-decoration-thickness: var(--underline-thickness-3);
                    text-underline-offset: var(--underline-offset-2);
                }
            }
        }

        @container header (width > 55rem) {
            display: flex;
            gap: var(--space-5);
        }
    }
</style>

<script>
    const button = document.querySelector('#menuButton')
    const doc = document.documentElement
    const nav = document.querySelector('#topNav')
    const className = 'navIsOpen'

    button?.addEventListener('click', () => {
        let startOpacity = 0
        let endOpacity = 1

        if (doc.classList.contains(className)) {
            startOpacity = 1
            endOpacity = 0
        }

        nav?.animate([{ opacity: startOpacity }, { opacity: endOpacity }], {
            duration: 100,
        })

        doc.classList.toggle(className)
    })

    doc.addEventListener('keyup', (el) => {
        if (el.key === 'Escape') {
            doc.classList.remove(className)
        }
    })
</script>
