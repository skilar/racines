---
import getJournalEntryDate from '@lib/get-journal-entry-date'

import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { RichTextField } from '@prismicio/client'

interface Props {
    description?: RichTextField | undefined
    headingHtml: string
    hideHeading?: boolean
    publicationDate: string
    subtitle?: RichTextField | undefined
}

const {
    description,
    headingHtml,
    hideHeading = false,
    publicationDate,
    subtitle,
} = Astro.props
const { lang } = Astro.locals

const dateString = getJournalEntryDate(publicationDate, lang)
---

<div class="postMeta">
    <h1 class:list={[{ visuallyHidden: hideHeading }]} set:html={headingHtml} />

    {subtitle && <PrismicRichText class="subtitle" richText={subtitle} />}

    {description && (
        <PrismicRichText class="description" richText={description} />
    )}

    <time class="date" datetime={publicationDate}>
        {dateString}
    </time>
</div>

<style>
    .postMeta {
        hyphens: auto;
        margin-block: var(--space-8);
        margin-inline: auto;
        max-width: var(--width-text);
        padding-bottom: var(--space-5);
        text-align: center;
    }

    h1 {
        font-size: var(--font-size-6);
        margin-bottom: var(--space-3);
    }

    .subtitle {
        color: var(--color-red-8);
        font-feature-settings: 'swsh';
        font-size: var(--font-size-4);
        font-style: italic;
        font-weight: var(--font-weight-medium);
    }

    .date,
    .description {
        font-size: var(--font-size-4);
        margin-top: var(--space-4);
    }

    .date {
        color: var(--color-blue-11);
        display: block;
        font-weight: var(--font-weight-medium);
    }
</style>
