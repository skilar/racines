---
import { UI } from '@lib/i18n'
import { collectNotes } from '@lib/notes'

import type { SliceZone } from '@prismicio/client'
import type { AnySlice } from '@typez/prismic'

interface Props {
    slices: SliceZone<AnySlice>
}

const { slices } = Astro.props
const { lang } = Astro.locals

const notes = collectNotes(slices, lang)
---

{notes.length > 0 && (
    <section class="endnotes" aria-labelledby="endnotesHeading">
        <h2 class="endnotesHeading" id="endnotesHeading">
            {UI[lang].notes}
        </h2>

        <ol class="backlinkList">
            {notes.map((note) => (
                <li class="backlinkListItem" id={note.id}>
                    <Fragment set:html={note.html} />{' '}
                    <a
                        class="backlink"
                        href={`#${note.refId}`}
                        aria-label={UI[lang].backToRef(note.number)}
                    >
                        ^
                    </a>
                </li>
            ))}
        </ol>
    </section>
)}

<style>
    .endnotes {
        border-top: 1px solid var(--color-ivory-4);
        font-size: var(--font-size-3);
        margin-inline: auto;
        margin-top: var(--space-9);
        max-width: var(--width-text);
        padding-top: var(--space-4);
    }

    .endnotesHeading {
        font-family: var(--font-serif);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        margin-bottom: var(--space-4);
    }

    .backlinkList {
        list-style-type: decimal;
        margin-left: var(--space-4);
    }

    .backlinkListItem {
        scroll-margin-block: var(--space-6);

        &:not(:last-child) {
            margin-bottom: var(--space-2);
        }
    }

    .backlink {
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-ultra);
        text-decoration: none;
        white-space: nowrap;

        &:hover {
            text-decoration: underline;
            text-decoration-thickness: var(--underline-thickness-1);
        }
    }
</style>

<style is:global>
    .noteRef {
        scroll-margin-block: var(--space-6);
    }

    .noteLink,
    .noteButton {
        background-color: var(--color-red-8);
        border-radius: 8px;
        color: var(--color-ivory-1);
        font-size: var(--font-size-2-sc);
        font-variant-numeric: lining-nums;
        line-height: inherit;
        padding-block: 0;
        padding-inline: var(--space-2);
        position: relative;
        text-decoration: none;
        top: -0.2rem;

        &:hover {
            background-color: var(--color-red-6);
        }
    }

    .noteButton {
        display: none;
    }

    .noteTip {
        background-color: var(--color-ivory-1);
        border: 1px solid var(--color-ivory-4);
        box-shadow: 0 2px 4px oklch(0 0 0 / 15%);
        color: var(--color-black);
        display: none;
        font-size: var(--font-size-3);
        hyphens: manual;
        inset: auto;
        justify-self: anchor-center;
        margin: var(--space-2) var(--space-4);
        max-width: min(24rem, calc(100% - 2 * var(--space-4)));
        padding: var(--space-3) var(--space-4);
        position-area: block-end;
        position-try-fallbacks: flip-block;
        text-align: start;
        width: max-content;
    }

    .noteTip:popover-open {
        display: block;
    }

    @supports selector(:popover-open) and (anchor-name: --a) {
        .noteLink {
            display: none;
        }

        .noteButton {
            display: inline-block;
        }

        .noteRef:has(+ .noteTip:popover-open) .noteButton {
            background-color: var(--color-red-6);
        }
    }
</style>
