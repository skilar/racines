---
import { isFilled } from '@prismicio/client'
import getEntryTitle from '@lib/get-entry-title'
import getOgImage from '@lib/get-og-image'
import { client } from '@lib/prismic'
import { collectZoomableImages } from '@lib/zoom'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'
import SliceZone from '@components/common/SliceZone.astro'
import Endnotes from '@components/entry/Endnotes.astro'
import JournalEntryDate from '@components/entry/JournalEntryDate.astro'
import Lightbox from '@components/entry/Lightbox.astro'

interface Props {
    uid: string
}

const { uid } = Astro.props
const { lang } = Astro.locals

const page = await client.getByUID('notebook_post', uid, { lang })
const zoomableImages = collectZoomableImages(page.data.slices)
const ogImage = getOgImage(page.data.meta_image)
const heading = getEntryTitle(page.data, lang)

// An untitled post takes its heading from its opening words, which the
// reader is about to see anyway, so only assistive tech gets the heading.
const hideHeading = !isFilled.richText(page.data.title)
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    modifiedTime={page.last_publication_date}
    ogImage={ogImage?.url}
    ogImageAlt={ogImage?.alt}
    ogType="article"
    publishedTime={page.first_publication_date}
    title={page.data.meta_title ?? heading}
>
    <main id="main" class="contained">
        <article>
            <JournalEntryDate publicationDate={page.first_publication_date} />

            <h1 class:list={['title', { visuallyHidden: hideHeading }]}>
                {heading}
            </h1>

            <div class="post">
                {isFilled.sliceZone(page.data.slices) && (
                    <SliceZone
                        hasBigCap={false}
                        numberNotes
                        slices={page.data.slices}
                        zoomImages
                    />
                )}

                <Endnotes slices={page.data.slices} />
            </div>
        </article>

        <Lightbox images={zoomableImages} />
    </main>
</LayoutWithHeader>

<style>
    main {
        container: journalEntry / inline-size;
        margin-block: var(--space-5) var(--space-9);
    }

    article {
        background-color: var(--color-ivory-1);
        border-block: var(--double-border);
        font-size: var(--font-size-4);
        margin-inline: auto;
        max-width: var(--width-text);
        padding: var(--space-5);
    }

    .title {
        color: var(--color-black);
        font-size: var(--font-size-5);
        font-weight: var(--font-weight-bold);
    }

    .post {
        .title + & {
            margin-top: var(--space-4);
        }

        > :global(div) {
            margin-inline: auto;
        }

        :global(> div:has(+ div)) {
            margin-bottom: var(--space-5);
        }

        .note-ref {
            background-color: var(--color-red-8);
            border-radius: 8px;
            color: var(--color-ivory-1);
            font-size: var(--font-size-2-sc);
            font-variant-numeric: lining-nums;
            padding-inline: var(--space-2);
            position: relative;
            scroll-margin-block: var(--space-6);
            text-decoration: none;
            top: -0.2rem;

            &:hover {
                background-color: var(--color-red-6);
            }
        }
    }
</style>
