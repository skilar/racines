---
import { client } from '@lib/prismic'
import getFixer from '@lib/get-fixer'
import getJournalEntryDate from '@lib/get-journal-entry-date'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'

import Image from '../../common/Image.astro'
import PrismicRichText from '../../common/PrismicRichText.astro'
import SliceZone from '../../common/SliceZone.astro'

interface Props {
    uid: string
}

const { uid } = Astro.props
const { lang } = Astro.locals

const page = await client.getByUID('blog_post', uid, { lang })
const dateString = getJournalEntryDate(page.first_publication_date, lang)

const title = getFixer(lang).fixText(page.data.title || '')
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    title={page.data.meta_title}
>
    <main id="main" class="contained">
        <article>
            <div class="postMeta">
                <h1>{title}</h1>

                <PrismicRichText
                    class="subtitle"
                    richText={page.data.subtitle}
                />

                <PrismicRichText
                    class="description"
                    richText={page.data.short_description}
                />

                <p class="date" set:html={dateString} />
            </div>

            <div class="post">
                <Image
                    class="coverImage"
                    image={page.data.cover_image}
                    priority
                />

                <SliceZone slices={page.data.slices} />
            </div>
        </article>
    </main>
</LayoutWithHeader>

<style>
    main {
        margin-block: var(--space-5) var(--space-9);
    }

    .postMeta {
        hyphens: auto;
        margin-block: var(--space-8);
        max-width: var(--width-text);
        padding-bottom: var(--space-5);
        text-align: center;
    }

    h1 {
        font-size: var(--font-size-6);
        margin-bottom: var(--space-3);
    }

    .subtitle {
        color: var(--color-red-8);
        font-size: var(--font-size-4);
        font-style: italic;
        font-weight: var(--font-weight-medium);
    }

    .date,
    .description {
        font-size: var(--font-size-4);
        margin-top: var(--space-4);
    }

    .date {
        color: var(--color-blue-11);
        font-weight: var(--font-weight-medium);
    }

    .post {
        counter-reset: footnote;

        div:has(+ div) {
            margin-bottom: var(--space-8);
        }

        .sidenote-ref::after {
            counter-increment: footnote;
            content: counter(footnote);
            display: inline-block;
            font-variant-numeric: ordinal;
            margin-left: -0.125rem;
        }

        .sidenote {
            clear: right;
            float: right;
            font-size: var(--font-size-3);
            margin-bottom: 1rem;
            margin-right: calc(
                (var(--width-sidenote) + var(--width-sidenote-gap)) * -1
            );
            width: var(--width-sidenote);

            &::before {
                content: counter(footnote);
                font-variant-numeric: ordinal;
                margin-right: var(--space-1);
            }
        }
    }

    .coverImage {
        margin-bottom: var(--space-9);
        max-width: var(--width-image);
    }
</style>
