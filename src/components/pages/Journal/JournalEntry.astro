---
import { client } from '@lib/prismic'
import { fixText } from '@lib/get-fixer'
import getJournalEntryDate from '@lib/get-journal-entry-date'
import { UI } from '@lib/i18n'
import { collectSidenotes } from '@lib/sidenotes'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'

import Image from '../../common/Image.astro'
import PrismicRichText from '../../common/PrismicRichText.astro'
import SliceZone from '../../common/SliceZone.astro'

interface Props {
    uid: string
}

const { uid } = Astro.props
const { lang } = Astro.locals

const page = await client.getByUID('blog_post', uid, { lang })
const dateString = getJournalEntryDate(page.first_publication_date, lang)
const title = fixText(page.data.title, lang)
const sidenotes = collectSidenotes(page.data.slices, lang)
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    title={page.data.meta_title}
>
    <main id="main" class="contained">
        <article>
            <div class="postMeta">
                <h1>{title}</h1>

                <PrismicRichText
                    class="subtitle"
                    richText={page.data.subtitle}
                />

                <PrismicRichText
                    class="description"
                    richText={page.data.short_description}
                />

                <p class="date" set:html={dateString} />
            </div>

            <div class="post">
                <Image
                    class="coverImage"
                    image={page.data.cover_image}
                    priority
                />

                <SliceZone slices={page.data.slices} numberSidenotes />

                {
                    sidenotes.length > 0 && (
                        <section
                            class="endnotes"
                            aria-labelledby="endnotesHeading"
                        >
                            <h2 id="endnotesHeading">{UI[lang].notes}</h2>

                            <ol>
                                {sidenotes.map((note) => (
                                    <li id={note.id}>
                                        <Fragment set:html={note.html} />{' '}
                                        <a
                                            class="backlink"
                                            href={`#${note.refId}`}
                                            aria-label={UI[lang].backToRef(
                                                note.number,
                                            )}
                                        >
                                            ↩
                                        </a>
                                    </li>
                                ))}
                            </ol>
                        </section>
                    )
                }
            </div>

            <div class="authorCallout">
                <h2>{page.data.author.data.name}</h2>
                <PrismicRichText richText={page.data.author.data.biography} />
            </div>
        </article>
    </main>
</LayoutWithHeader>

<style>
    main {
        margin-block: var(--space-5) var(--space-9);
        max-width: var(--width-text);
    }

    .postMeta {
        hyphens: auto;
        margin-block: var(--space-8);
        padding-bottom: var(--space-5);
        text-align: center;
    }

    h1 {
        font-size: var(--font-size-6);
        margin-bottom: var(--space-3);
    }

    .subtitle {
        color: var(--color-red-8);
        font-size: var(--font-size-4);
        font-style: italic;
        font-weight: var(--font-weight-medium);
    }

    .date,
    .description {
        font-size: var(--font-size-4);
        margin-top: var(--space-4);
    }

    .date {
        color: var(--color-blue-11);
        font-weight: var(--font-weight-medium);
    }

    .post {
        div:has(+ div) {
            margin-bottom: var(--space-8);
        }

        .sidenote-ref {
            font-variant-numeric: ordinal;
            margin-left: -0.125rem;
            scroll-margin-block: var(--space-6);
            text-decoration: none;

            &:hover {
                color: var(--color-red-8);
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-1);
            }
        }

        .sidenote {
            clear: right;
            float: right;
            font-size: var(--font-size-3);
            margin-bottom: 1rem;
            margin-right: calc(
                (var(--width-sidenote) + var(--width-sidenote-gap)) * -1
            );
            margin-top: 0.25rem;
            width: var(--width-sidenote);
        }

        .sidenoteNumber {
            font-variant-numeric: ordinal;
            margin-right: calc(var(--space-1) / 2);
        }
    }

    .coverImage {
        margin-bottom: var(--space-9);
        max-width: var(--width-image);
    }

    .endnotes {
        border-top: 1px solid var(--color-ivory-4);
        font-size: var(--font-size-3);
        margin-top: var(--space-9);
        padding-top: var(--space-4);

        h2 {
            font-family: var(--font-text);
            font-size: var(--font-size-4-sc);
            font-variant-caps: all-small-caps;
            font-weight: var(--font-weight-medium);
            margin-bottom: var(--space-4);
        }

        ol {
            list-style-type: decimal;
            margin-left: var(--space-4);
        }

        li {
            scroll-margin-block: var(--space-6);

            &:not(:last-child) {
                margin-bottom: var(--space-2);
            }
        }

        .backlink {
            font-size: var(--font-size-2);
            text-decoration: none;
            white-space: nowrap;

            &:hover {
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-1);
            }
        }
    }

    .authorCallout {
        background-color: var(--color-ivory-2);
        border: 1px solid var(--color-ivory-4);
        font-size: var(--font-size-4);
        margin-top: var(--space-9);
        padding: var(--space-3);
    }
</style>
