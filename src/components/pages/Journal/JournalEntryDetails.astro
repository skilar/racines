---
import { isFilled } from '@prismicio/client'
import { getEntryTitleHtml } from '@lib/get-entry-title'
import getPostPreview from '@lib/get-post-preview'
import { UI } from '@lib/i18n'

import Image from '@components/common/Image.astro'
import ImageCaption from '@components/common/ImageCaption.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'
import SliceZone from '@components/common/SliceZone.astro'
import JournalEntryDate from '@components/entry/JournalEntryDate.astro'

import type { ImageField, RichTextField } from '@prismicio/client'
import type { JournalItem } from '@lib/get-journal-items'
import type { PostPreview } from '@lib/get-post-preview'

interface Props {
    item: JournalItem
    showLabel?: boolean
}

const { item, showLabel = true } = Astro.props
const { lang } = Astro.locals

let coverImage: ImageField | undefined
let coverImageDescription: RichTextField | undefined
let description: RichTextField | undefined
let hasTitle = true
let label: string | undefined
let preview: PostPreview | null = null

switch (item.type) {
    case 'blog_post':
        coverImage = item.doc.data.cover_image
        coverImageDescription = item.doc.data.cover_image_description
        description = item.doc.data.short_description
        preview = getPostPreview(item.doc.data.slices)
        break
    case 'notebook_post':
        hasTitle = isFilled.richText(item.doc.data.title)
        break
    case 'recipe':
        label = showLabel ? UI[lang].recipe : undefined
        preview = getPostPreview(item.doc.data.slices)
        break
}

const subtitle = item.type === 'blog_post' ? item.doc.data.subtitle : undefined
---

<div
    class:list={[
        'header',
        {
            journal: item.type === 'blog_post',
            notebook: item.type === 'notebook_post',
            recipe: item.type === 'recipe',
        },
    ]}
>
    {label && <p class="label">{label}</p>}

    {item.type === 'notebook_post' && (
        <JournalEntryDate link={item} publicationDate={item.publicationDate} />
    )}

    {hasTitle && (
        <h2
            class:list={[
                'title',
                {
                    journal: item.type === 'blog_post',
                    notebook: item.type === 'notebook_post',
                    recipe: item.type === 'recipe',
                },
            ]}
        >
            <a
                href={item.href}
                set:html={getEntryTitleHtml(item.doc.data, lang)}
            />
        </h2>
    )}

    {subtitle && <PrismicRichText class="subtitle" richText={subtitle} />}
    {description && (
        <PrismicRichText class="description" richText={description} />
    )}

    {item.type !== 'notebook_post' && (
        <JournalEntryDate publicationDate={item.publicationDate} />
    )}
</div>

{coverImage && isFilled.image(coverImage) && (
    <div class="imageWrapper">
        <Image image={coverImage} />

        {coverImageDescription && (
            <ImageCaption caption={coverImageDescription} />
        )}
    </div>
)}

{preview && <PrismicRichText class="preview prose" richText={preview.text} />}

{preview?.hasMore && (
    <a class="readMore" href={item.href}>
        <span class="linkTitle">{UI[lang].readMore}</span>
        <span class="visuallyHidden"> — {item.title}</span>
        <span class="arrow">→</span>
    </a>
)}

{item.type === 'notebook_post' && (
    <div class="notebookPostBody">
        <SliceZone slices={item.doc.data.slices} />
    </div>
)}

<style>
    .header.journal {
        text-align: center;
    }

    .label {
        color: var(--color-blue-10);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        line-height: 1;
        margin-bottom: var(--space-2);
    }

    .title {
        font-size: var(--font-size-5-sc);

        &.notebook {
            font-size: var(--font-size-4-sc);
        }

        a {
            color: var(--color-black);
            font-weight: var(--font-weight-bold);
            text-decoration: none;

            &:hover {
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-2);
            }
        }
    }

    .subtitle {
        color: var(--color-red-8);
        font-style: italic;
        font-weight: var(--font-weight-medium);
        margin-top: var(--space-4);

        @container journal (width > 40rem) {
            margin-top: 0;
        }
    }

    .description {
        color: var(--color-ivory-11);
        font-size: var(--font-size-3-sc);
        margin-block: var(--space-5);
    }

    .imageWrapper {
        margin-top: var(--space-6);
    }

    .preview {
        margin-top: var(--space-6);
    }

    .notebookPostBody {
        .header + & {
            margin-top: var(--space-4);
        }

        :global(> div:has(+ div)) {
            margin-bottom: var(--space-7);
        }
    }

    .readMore {
        color: var(--color-red-8);
        display: inline-flex;
        font-weight: var(--font-weight-bold);
        gap: var(--space-1);
        margin-top: var(--space-7);
        text-decoration: none;

        .arrow {
            transition: translate 200ms ease-in-out;
        }

        &:hover {
            .linkTitle {
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-1);
            }

            .arrow {
                translate: var(--space-1) 0;
            }
        }
    }
</style>
