---
import { isFilled } from '@prismicio/client'
import { client } from '@lib/prismic'
import { fixText } from '@lib/get-fixer'
import { UI } from '@lib/i18n'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'

const { lang } = Astro.locals

const page = await client.getByUID('page', 'journal', { lang })
const blogPosts = await client.getByType('blog_post', { lang })

const posts = blogPosts.results.map((post) => ({
    href: post.url,
    label: isFilled.keyText(post.data.title)
        ? fixText(post.data.title, lang)
        : UI[lang].untitledEntry,
}))
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    title={page.data.meta_title}
>
    <main id="main" class="contained">
        {
            isFilled.keyText(page.data.title) && (
                <div class="postMeta">
                    <h1>{fixText(page.data.title, lang)}</h1>
                </div>
            )
        }

        {
            posts.length > 0 && (
                <div class="post">
                    <ul>
                        {posts.map(({ href, label }) => (
                            <li>{href ? <a href={href}>{label}</a> : label}</li>
                        ))}
                    </ul>
                </div>
            )
        }
    </main>
</LayoutWithHeader>

<style>
    main {
        margin-top: var(--space-7);
    }

    h1 {
        font-size: var(--font-size-5);
    }

    ul {
        list-style-type: disc;
        margin-left: var(--space-6);
    }

    li {
        font-size: var(--font-size-4);
    }
</style>
