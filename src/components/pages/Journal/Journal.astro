---
import { client } from '@lib/prismic'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'

import type { Lang } from '@lib/constants'

interface Props {
    lang?: Lang
}

const { lang = 'en-us' } = Astro.props

const page = await client.getByType('blog_post', { lang })
---

<LayoutWithHeader lang={lang} title="Journal">
    <main id="main" class="contained">
        <div class="postMeta">
            <h1>Journal</h1>
        </div>

        <div class="post">
            <ul>
                {
                    page.results.map((post) => {
                        return (
                            <li>
                                <a href={post.url}>{post.data.title}</a>
                            </li>
                        )
                    })
                }
            </ul>
        </div>
    </main>
</LayoutWithHeader>

<style>
    main {
        margin-top: var(--space-7);
    }

    h1 {
        font-size: var(--font-size-5);
    }

    ul {
        list-style-type: disc;
        margin-left: var(--space-6);
    }

    li {
        font-size: var(--font-size-4);
    }
</style>
