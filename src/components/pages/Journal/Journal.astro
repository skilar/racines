---
import { JOURNAL_PAGE_UID, SECTION_PAGE_UIDS } from '@lib/constants'
import { getJournalItems } from '@lib/get-journal-items'
import { client } from '@lib/prismic'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'
import PageWrapper from '@components/layout/PageWrapper.astro'
import JournalEntryDetails from './JournalEntryDetails.astro'

import type { JournalType } from '@lib/constants'

interface Props {
    section?: JournalType | undefined
}

const { section } = Astro.props
const { lang } = Astro.locals

const pageUid = section ? SECTION_PAGE_UIDS[section][lang] : JOURNAL_PAGE_UID

const page = await client.getByUID('page', pageUid, { lang })
const items = await getJournalItems(lang, section && [section])
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    title={page.data.meta_title}
>
    <PageWrapper pageStyle={page.data.page_style} title={page.data.title}>
        {items.length > 0 && (
            <div class="posts">
                {items.map((item) => (
                    <article
                        class:list={[
                            {
                                journal: item.type === 'blog_post',
                                notebook: item.type === 'notebook_post',
                                recipe: item.type === 'recipe',
                            },
                        ]}
                    >
                        <div class="articleInnerWrapper">
                            <JournalEntryDetails
                                item={item}
                                showLabel={!section}
                            />
                        </div>
                    </article>
                ))}
            </div>
        )}
    </PageWrapper>
</LayoutWithHeader>

<style>
    .posts {
        container: journal / inline-size;
        display: grid;
        max-width: var(--width-text);
    }

    article {
        font-size: var(--font-size-4);
        max-width: var(--width-text);

        :global(.withSidebar) & {
            grid-template-columns: var(--with-sidebar-cols);
            gap: var(--with-sidebar-gap);
            max-width: unset;
        }

        &.notebook {
            &:has(+ .notebook) {
                padding-bottom: var(--space-8);
            }

            &:has(+ :is(.journal, .recipe)) {
                padding-bottom: calc(var(--space-8) * 2);
            }
        }

        &:is(.journal, .recipe) {
            &:has(+ :is(.journal, .notebook, .recipe)) {
                padding-bottom: calc(var(--space-8) * 2);
            }

            &:has(+ :is(.journal, .recipe)) {
                border-bottom: 2px solid var(--color-ivory-4);
                margin-bottom: calc(var(--space-8) * 2);
            }
        }
    }

    .notebook {
        .articleInnerWrapper {
            background-color: oklch(0.97 0.0093 99.98 / 60%);
            border: 1px solid var(--color-ivory-4);
            border-radius: 3px;
            padding: var(--space-5);
            padding-bottom: var(--space-7);
        }
    }
</style>
