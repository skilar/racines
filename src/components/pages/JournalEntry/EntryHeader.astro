---
import { isFilled } from '@prismicio/client'
import { fixText } from '@lib/get-fixer'
import { UI } from '@lib/i18n'
import getJournalEntryDate from '@lib/get-journal-entry-date'

import PrismicRichText from '../../common/PrismicRichText.astro'

import type { BlogPostDocument } from '@typez/generated/prismic'

interface Props {
    description: BlogPostDocument['data']['short_description']
    publicationDate: BlogPostDocument['first_publication_date']
    subtitle: BlogPostDocument['data']['subtitle']
    title: BlogPostDocument['data']['title']
}

const { description, publicationDate, subtitle, title } = Astro.props
const { lang } = Astro.locals

const dateString = getJournalEntryDate(publicationDate, lang)

const heading = isFilled.keyText(title)
    ? fixText(title, lang)
    : UI[lang].untitledEntry
---

<div class="postMeta">
    <h1>{heading}</h1>

    <PrismicRichText class="subtitle" richText={subtitle} />

    <PrismicRichText class="description" richText={description} />

    <time class="date" datetime={publicationDate}>{dateString}</time>
</div>

<style>
    .postMeta {
        hyphens: auto;
        margin-block: var(--space-8);
        margin-inline: auto;
        max-width: var(--width-text);
        padding-bottom: var(--space-5);
        text-align: center;
    }

    h1 {
        font-size: var(--font-size-6);
        margin-bottom: var(--space-3);
    }

    .subtitle {
        color: var(--color-red-8);
        font-size: var(--font-size-4);
        font-style: italic;
        font-weight: var(--font-weight-medium);
    }

    .date,
    .description {
        font-size: var(--font-size-4);
        margin-top: var(--space-4);
    }

    .date {
        color: var(--color-blue-11);
        display: block;
        font-weight: var(--font-weight-medium);
    }
</style>
