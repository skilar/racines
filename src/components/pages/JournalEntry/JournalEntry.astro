---
import { isFilled } from '@prismicio/client'
import getOgImage from '@lib/get-og-image'
import { client } from '@lib/prismic'
import { collectZoomableImages } from '@lib/zoom'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'
import SliceZone from '../../common/SliceZone.astro'
import AuthorCallout from './AuthorCallout.astro'
import CoverImage from './CoverImage.astro'
import Endnotes from './Endnotes.astro'
import EntryHeader from './EntryHeader.astro'
import Lightbox from './Lightbox.astro'

interface Props {
    uid: string
}

const { uid } = Astro.props
const { lang } = Astro.locals

const page = await client.getByUID('blog_post', uid, { lang })

const zoomableImages = collectZoomableImages(page.data.slices)

const ogImage = getOgImage(page.data.meta_image, page.data.cover_image)
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    ogImage={ogImage?.url}
    ogImageAlt={ogImage?.alt}
    title={page.data.meta_title}
>
    <main id="main" class="contained">
        <article>
            <EntryHeader
                description={page.data.short_description}
                publicationDate={page.first_publication_date}
                subtitle={page.data.subtitle}
                title={page.data.title}
            />

            <div class="post">
                <CoverImage
                    description={page.data.cover_image_description}
                    image={page.data.cover_image}
                />

                {
                    isFilled.sliceZone(page.data.slices) && (
                        <SliceZone
                            hasBigCap
                            numberNotes
                            slices={page.data.slices}
                            zoomImages
                        />
                    )
                }

                <Endnotes slices={page.data.slices} />
            </div>

            <AuthorCallout author={page.data.author} />
        </article>

        <Lightbox images={zoomableImages} />
    </main>
</LayoutWithHeader>

<style>
    main {
        container: journalEntry / inline-size;
        margin-block: var(--space-5) var(--space-9);
    }

    .post {
        > :global(div) {
            margin-inline: auto;
        }

        :global(> div:has(+ div)) {
            margin-bottom: var(--space-8);
        }

        .note-ref {
            font-variant-numeric: ordinal;
            margin-left: -0.125rem;
            scroll-margin-block: var(--space-6);
            text-decoration: none;

            &:hover {
                color: var(--color-red-8);
                text-decoration: underline;
                text-decoration-thickness: var(--underline-thickness-1);
            }
        }
    }
</style>
