---
import { asText, isFilled } from '@prismicio/client'
import getEntryTitle from '@lib/get-entry-title'
import getOgImage from '@lib/get-og-image'
import { client } from '@lib/prismic'
import { collectZoomableImages } from '@lib/zoom'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'
import SliceZone from '@components/common/SliceZone.astro'
import Endnotes from '@components/entry/Endnotes.astro'
import EntryHeader from '@components/entry/EntryHeader.astro'
import Lightbox from '@components/entry/Lightbox.astro'
import AuthorCallout from './AuthorCallout.astro'
import CoverImage from './CoverImage.astro'

interface Props {
    uid: string
}

const { uid } = Astro.props
const { lang } = Astro.locals

const page = await client.getByUID('blog_post', uid, { lang })

const zoomableImages = collectZoomableImages(page.data.slices)

const ogImage = getOgImage(page.data.meta_image, page.data.cover_image)

const heading = getEntryTitle(page.data, lang)

// Keeps the heading for assistive tech when an essay somehow has no title.
const hideHeading = !isFilled.richText(page.data.title)

const description = isFilled.keyText(page.data.meta_description)
    ? page.data.meta_description
    : asText(page.data.short_description)
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={description}
    modifiedTime={page.last_publication_date}
    ogImage={ogImage?.url}
    ogImageAlt={ogImage?.alt}
    ogType="article"
    publishedTime={page.first_publication_date}
    title={page.data.meta_title ?? heading}
>
    <main id="main" class="contained">
        <article>
            <EntryHeader
                description={page.data.short_description}
                heading={heading}
                hideHeading={hideHeading}
                publicationDate={page.first_publication_date}
                subtitle={page.data.subtitle}
            />

            <div class="post">
                <CoverImage
                    description={page.data.cover_image_description}
                    image={page.data.cover_image}
                />

                {isFilled.sliceZone(page.data.slices) && (
                    <SliceZone
                        hasBigCap
                        numberNotes
                        slices={page.data.slices}
                        zoomImages
                    />
                )}

                <Endnotes slices={page.data.slices} />
            </div>

            <AuthorCallout author={page.data.author} />
        </article>

        <Lightbox images={zoomableImages} />
    </main>
</LayoutWithHeader>

<style>
    main {
        container: journalEntry / inline-size;
        margin-block: var(--space-5) var(--space-9);
    }

    .post {
        > :global(div) {
            margin-inline: auto;
        }

        :global(> div:has(+ div)) {
            margin-bottom: var(--space-8);
        }
    }
</style>
