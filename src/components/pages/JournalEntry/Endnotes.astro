---
import { UI } from '@lib/i18n'
import { collectNotes } from '@lib/notes'

import type { BlogPostDocument } from '@typez/generated/prismic'

interface Props {
    slices: BlogPostDocument['data']['slices']
}

const { slices } = Astro.props
const { lang } = Astro.locals

const notes = collectNotes(slices, lang)
---

{
    notes.length > 0 && (
        <section class="endnotes" aria-labelledby="endnotesHeading">
            <h2 class="endnotesHeading" id="endnotesHeading">
                {UI[lang].notes}
            </h2>

            <ol class="backlinkList">
                {notes.map((note) => (
                    <li class="backlinkListItem" id={note.id}>
                        <Fragment set:html={note.html} />{' '}
                        <a
                            class="backlink"
                            href={`#${note.refId}`}
                            aria-label={UI[lang].backToRef(note.number)}
                        >
                            ^
                        </a>
                    </li>
                ))}
            </ol>
        </section>
    )
}

<style>
    .endnotes {
        border-top: 1px solid var(--color-ivory-4);
        font-size: var(--font-size-3);
        margin-inline: auto;
        margin-top: var(--space-9);
        max-width: var(--width-text);
        padding-top: var(--space-4);
    }

    .endnotesHeading {
        font-family: var(--font-serif);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        margin-bottom: var(--space-4);
    }

    .backlinkList {
        list-style-type: decimal;
        margin-left: var(--space-4);
    }

    .backlinkListItem {
        scroll-margin-block: var(--space-6);

        &:not(:last-child) {
            margin-bottom: var(--space-2);
        }
    }

    .backlink {
        font-size: var(--font-size-3);
        font-weight: var(--font-weight-ultra);
        text-decoration: none;
        white-space: nowrap;

        &:hover {
            text-decoration: underline;
            text-decoration-thickness: var(--underline-thickness-1);
        }
    }
</style>
