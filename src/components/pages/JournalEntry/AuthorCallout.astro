---
import Image from '../../common/Image.astro'
import PrismicRichText from '../../common/PrismicRichText.astro'

import type { AuthorDocument } from '@typez/generated/prismic'

interface Props {
    bio: AuthorDocument['data']['biography']
    photo: AuthorDocument['data']['photo']
}

const { bio, photo } = Astro.props
---

<div class="authorCallout">
    {
        photo && (
            <div>
                <Image image={photo} />
            </div>
        )
    }

    <div class="about">
        <h2>About the Author</h2>
        <PrismicRichText richText={bio} />
    </div>
</div>

<style>
    .authorCallout {
        background-color: var(--color-ivory-2);
        border: 1px solid var(--color-ivory-4);
        border-bottom: var(--double-border);
        font-size: var(--font-size-4);
        margin-top: var(--space-9);

        &:has(div + div) {
            display: grid;
            grid-template-columns: 10rem 1fr;
        }
    }

    .about {
        padding: var(--space-5);
    }

    h2 {
        color: var(--color-blue-10);
        font-family: var(--font-serif);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        padding-bottom: var(--space-1);
    }
</style>
