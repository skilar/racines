---
import PrismicRichText from '../../common/PrismicRichText.astro'

import type { AuthorDocument } from '@typez/generated/prismic'

interface Props {
    bio: AuthorDocument['data']['biography']
}

const { bio } = Astro.props
---

<div class="authorCallout">
    <h2>About the Author</h2>
    <PrismicRichText richText={bio} />
</div>

<style>
    .authorCallout {
        background-color: var(--color-ivory-2);
        border: 1px solid var(--color-ivory-4);
        font-size: var(--font-size-4);
        margin-top: var(--space-9);
        padding: var(--space-3);
    }
</style>
