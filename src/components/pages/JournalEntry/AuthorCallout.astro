---
import { isFilled } from '@prismicio/client'
import { UI } from '@lib/i18n'

import Image from '../../common/Image.astro'
import PrismicRichText from '../../common/PrismicRichText.astro'

import type { BlogPostDocument } from '@typez/generated/prismic'

interface Props {
    author: BlogPostDocument['data']['author']
}

const { author } = Astro.props
const { lang } = Astro.locals
---

{
    isFilled.contentRelationship(author) &&
        author.data &&
        isFilled.richText(author.data.biography) && (
            <div class="authorCallout">
                {isFilled.image(author.data.photo) && (
                    <div>
                        <Image image={author.data.photo} />
                    </div>
                )}

                <div class="about">
                    <h2>{UI[lang].aboutTheAuthor}</h2>
                    <PrismicRichText richText={author.data.biography} />
                </div>
            </div>
        )
}

<style>
    .authorCallout {
        background-color: var(--color-ivory-2);
        border: 1px solid var(--color-ivory-4);
        border-bottom: var(--double-border);
        font-size: var(--font-size-4);
        margin-inline: auto;
        margin-top: var(--space-9);
        max-width: var(--width-text);

        &:has(div + div) {
            display: grid;
            grid-template-columns: 10rem 1fr;
        }
    }

    .about {
        padding: var(--space-5);
    }

    h2 {
        color: var(--color-blue-10);
        font-family: var(--font-serif);
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
        padding-bottom: var(--space-1);
    }
</style>
