---
import { isFilled } from '@prismicio/client'
import { client } from '@lib/prismic'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'
import SliceZone from '../common/SliceZone.astro'

const { lang } = Astro.locals

const page = await client.getSingle('homepage', { lang })
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    title={page.data.meta_title}
>
    <main id="main" class="bleedGrid">
        {
            isFilled.sliceZone(page.data.slices) && (
                <SliceZone slices={page.data.slices} />
            )
        }
    </main>
</LayoutWithHeader>

<style>
    .bleedGrid {
        display: grid;
        grid-template-columns:
            [full-start] minmax(var(--padding-inline), 1fr)
            [content-start] min(
                var(--width-wide),
                100% - var(--padding-inline) * 2
            )
            [content-end] minmax(var(--padding-inline), 1fr)
            [full-end];
        padding-bottom: var(--space-7);
    }

    .bleedGrid > :global(*) {
        grid-column: content;
    }

    .bleedGrid > :global([data-slice-type='quote']) {
        grid-column: full;
    }
</style>
