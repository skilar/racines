---
import { isFilled } from '@prismicio/client'
import { UI } from '@lib/i18n'

import Image from '@components/common/Image.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'
import LangSelector from '@components/layout/LangSelector.astro'

import type { AlternateLanguage } from '@prismicio/client'
import type { NavLink } from '@lib/prismic-link-resolver'
import type { HomepageDocument } from '@typez/generated/prismic'

interface Props {
    alternateLanguages?: AlternateLanguage[]
    description: HomepageDocument['data']['description']
    floralImage: HomepageDocument['data']['floral_image']
    mainImage: HomepageDocument['data']['main_image']
    nav: NavLink[]
    subtitle: HomepageDocument['data']['subtitle']
    title: HomepageDocument['data']['title']
}

const {
    alternateLanguages,
    description,
    floralImage,
    mainImage,
    nav,
    subtitle,
    title,
} = Astro.props
const { lang } = Astro.locals
---

<div class="container">
    <div class="titlePage">
        <LangSelector alternateLanguages={alternateLanguages} style="hangtag" />

        <div class="mainImageContainer">
            {isFilled.image(mainImage) && (
                <Image class="mainImage" image={mainImage} quality={75} />
            )}
        </div>

        <div class="textWithBgImage">
            <div class="textWrapper">
                <div class="text">
                    <div>
                        {isFilled.richText(title) && (
                            <PrismicRichText class="title" richText={title} />
                        )}

                        <PrismicRichText class="subtitle" richText={subtitle} />
                    </div>

                    <PrismicRichText class="caption" richText={description} />

                    {nav.length > 0 && (
                        <nav aria-label={UI[lang].menu}>
                            <ul class="nav">
                                {nav.map(({ ariaCurrent, attrs, label }) => (
                                    <li>
                                        <a
                                            {...attrs}
                                            aria-current={ariaCurrent}
                                        >
                                            <span class="linkTitle">
                                                {label}
                                            </span>
                                            <span class="arrow">→</span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    )}
                </div>
            </div>

            <div class="illustration">
                {isFilled.image(floralImage) && (
                    <Image
                        class="illustrationImage"
                        image={floralImage}
                        quality={75}
                        withBackgroundImage={false}
                    />
                )}
            </div>
        </div>
    </div>
</div>

<style>
    .container {
        container: titlePage / inline-size;
    }

    .titlePage {
        display: flex;
        flex-direction: column-reverse;
        position: relative;

        @container titlePage (width > 50rem) {
            flex-direction: row;
        }
    }

    .mainImageContainer {
        max-height: 100svh;
        overflow: hidden;

        @container titlePage (width > 50rem) {
            flex-grow: 1;
        }

        @container titlePage (width > 72rem) {
            flex-basis: 100%;
        }
    }

    .mainImage {
        object-fit: cover;
        object-position: center;
        height: 100%;
        min-height: 100svh;
    }

    .textWithBgImage {
        align-items: center;
        background-color: var(--color-red-10);
        color: var(--color-white);
        container: textWithBgImage / inline-size;
        display: flex;
        justify-content: center;
        overflow: hidden;
        position: relative;
        text-align: center;
        z-index: 1;

        @container titlePage (width > 50rem) {
            flex-basis: 100%;
            flex-grow: 1;
        }
    }

    .textWrapper {
        align-items: center;
        background-color: oklch(0.361 0.1302 15.24 / 50%);
        display: flex;
        height: 100%;
        padding-block: calc(var(--space-9) * 2);
        padding-inline: var(--space-6);
        position: relative;
        width: 100%;
        z-index: 10;

        @container titlePage (width > 50rem) {
            padding: var(--space-6);
        }

        @container textWithBgImage (width >= 43rem) {
            background-color: transparent;
        }
    }

    .text {
        display: grid;
        gap: var(--space-7);
        margin-inline: auto;
        max-height: 100svh;
        max-width: 55ch;
    }

    .title {
        font-size: var(--font-size-6-sc);
        font-weight: var(--font-weight-bold);
        line-height: 1.1;
        margin-bottom: var(--space-2);
    }

    .subtitle {
        font-size: var(--font-size-4);
        font-style: italic;
    }

    .caption {
        font-size: var(--font-size-3-sc);
        margin-bottom: var(--space-3);

        a {
            color: var(--color-ivory-2);
        }
    }

    .nav {
        border-block: var(--double-border);
        display: grid;
        font-size: var(--font-size-4);
        gap: var(--space-2);
        padding-block: var(--space-4) var(--space-5);
        text-align: left;

        .arrow {
            transition: translate 200ms ease-in-out;
        }

        a {
            color: var(--color-white);
            display: flex;
            justify-content: space-between;
            text-decoration: none;

            &:hover {
                .linkTitle {
                    text-decoration: underline;
                    text-decoration-thickness: 1px;
                }

                .arrow {
                    translate: 1rem 0;
                }
            }
        }
    }

    .illustration {
        bottom: -0.5rem;
        opacity: 0.85;
        position: absolute;
        right: -2rem;
        right: 0;
        top: 1.5rem;
        width: 17rem;
        z-index: 1;
    }

    .illustrationImage {
        height: 100%;
        width: auto;
    }
</style>
