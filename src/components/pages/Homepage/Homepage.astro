---
import { isFilled } from '@prismicio/client'
import { client, getLayout } from '@lib/prismic'
import { getNavLinks } from '@lib/prismic-link-resolver'

import LayoutWithFooter from '@layouts/LayoutWithFooter.astro'
import SliceZone from '../../common/SliceZone.astro'
import TitlePage from './TitlePage.astro'

const { lang } = Astro.locals

const page = await client.getSingle('homepage', { lang })
const layout = await getLayout(lang)
const nav = getNavLinks(layout.data.menu, {
    currentPath: Astro.url.pathname,
    lang,
})
---

<LayoutWithFooter
    description={page.data.meta_description}
    title={page.data.meta_title}
>
    <main id="main">
        <TitlePage
            alternateLanguages={page.alternate_languages}
            description={page.data.description}
            floralImage={page.data.floral_image}
            mainImage={page.data.main_image}
            nav={nav}
            subtitle={page.data.subtitle}
            title={page.data.title}
        />

        <div class="bleedGrid">
            {
                isFilled.sliceZone(page.data.slices) && (
                    <SliceZone slices={page.data.slices} />
                )
            }
        </div>
    </main>
</LayoutWithFooter>

<style>
    .bleedGrid {
        display: grid;
        grid-template-columns:
            [full-start] minmax(var(--padding-inline), 1fr)
            [content-start] min(
                var(--width-wide),
                100% - var(--padding-inline) * 2
            )
            [content-end] minmax(var(--padding-inline), 1fr)
            [full-end];
        padding-bottom: var(--space-7);
    }

    .bleedGrid > :global(*) {
        grid-column: content;
    }

    .bleedGrid
        > :global(
            [data-slice-type='quote'],
            [data-slice-type='hero'][data-slice-variation='imageWithGradient']
        ) {
        grid-column: full;
    }
</style>
