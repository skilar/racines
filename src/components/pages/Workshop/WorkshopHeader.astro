---
import { isFilled } from '@prismicio/client'
import { fixText } from '@lib/get-fixer'
import { UI } from '@lib/i18n'
import { getLinkAttrs } from '@lib/prismic-link-resolver'

import ArrowLink from '@components/common/ArrowLink.astro'
import Image from '@components/common/Image.astro'
import PrismicRichText from '@components/common/PrismicRichText.astro'
import WorkshopBooking from './WorkshopBooking.astro'
import WorkshopDetailsGrid from './WorkshopDetailsGrid.astro'

import type { WorkshopDocument } from '@typez/generated/prismic'

interface Props {
    bookingAvailability: WorkshopDocument['data']['booking_availability']
    bookingAvailabilityDescription: WorkshopDocument['data']['booking_availability_description']
    bookingLink: WorkshopDocument['data']['booking_link']
    bookingStatus: WorkshopDocument['data']['booking_status']
    capacity: WorkshopDocument['data']['capacity']
    description: WorkshopDocument['data']['description']
    duration: WorkshopDocument['data']['duration']
    featuredImage: WorkshopDocument['data']['featured_image']
    language: WorkshopDocument['data']['language']
    level: WorkshopDocument['data']['level']
    notifyTag: string
    price: WorkshopDocument['data']['price']
    privateWorkshopLink: WorkshopDocument['data']['private_workshop_link']
    showPrivateWorkshopLink: WorkshopDocument['data']['show_private_workshop_link']
    subtitle: WorkshopDocument['data']['subtitle']
    title: WorkshopDocument['data']['title']
}

const {
    bookingAvailability,
    bookingAvailabilityDescription,
    bookingLink,
    bookingStatus,
    capacity,
    description,
    duration,
    featuredImage,
    language,
    level,
    notifyTag,
    price,
    privateWorkshopLink,
    showPrivateWorkshopLink,
    subtitle,
    title,
} = Astro.props
const { lang } = Astro.locals

const privateWorkshopLinkAttrs = showPrivateWorkshopLink
    ? getLinkAttrs(privateWorkshopLink)
    : null

const privateWorkshopCaption = isFilled.keyText(privateWorkshopLink.text)
    ? fixText(privateWorkshopLink.text, lang)
    : UI[lang].requestPrivateWorkshop
---

<div class="header">
    <div class="contained layout">
        {isFilled.image(featuredImage) && (
            <div class="featuredImage">
                <Image
                    image={featuredImage}
                    priority
                    sizes="(min-width: 60rem) 35rem, 100vw"
                />
            </div>
        )}

        <div class="textWrapper">
            <PrismicRichText class="title" richText={title} />
            <PrismicRichText class="subtitle" richText={subtitle} />
            <PrismicRichText class="description" richText={description} />

            <WorkshopDetailsGrid
                capacity={capacity}
                class="workshopDetails"
                duration={duration}
                language={language}
                level={level}
                price={price}
            />

            <div class="ctaWrapper">
                <PrismicRichText
                    class="bookingAvailability"
                    richText={bookingAvailability}
                />

                <PrismicRichText
                    class="bookingAvailabilityDescription"
                    richText={bookingAvailabilityDescription}
                />

                <WorkshopBooking
                    bookingLink={bookingLink}
                    bookingStatus={bookingStatus}
                    notifyTag={notifyTag}
                />
            </div>

            {privateWorkshopLinkAttrs && (
                <ArrowLink
                    caption={privateWorkshopCaption}
                    class="privateWorkshopLink"
                    {...privateWorkshopLinkAttrs}
                />
            )}
        </div>
    </div>
</div>

<style>
    .header {
        align-items: center;
        container: workshopHeader / inline-size;
        display: flex;
        padding-block: var(--space-9);
        min-height: 100vh;
    }

    .layout {
        display: grid;
        gap: var(--space-7);

        @container workshopHeader (width > 60rem) {
            align-items: center;
            gap: calc(var(--space-8) * 2);
            grid-template-columns: minmax(0, 40rem) minmax(0, 1fr);
        }
    }

    .featuredImage {
        border: var(--image-border-thin);
        border-color: var(--color-ivory-4);
        max-width: 30rem;

        @container workshopHeader (width > 60rem) {
            grid-column: 2;
            grid-row: 1;
        }
    }

    .textWrapper {
        max-width: var(--width-text);

        @container workshopHeader (width > 60rem) {
            grid-column: 1;
            grid-row: 1;
        }
    }

    .title {
        font-size: var(--font-size-6);
        line-height: 1.1;
    }

    .subtitle {
        font-size: var(--font-size-4-sc);
        font-style: italic;
        font-weight: var(--font-weight-medium);
        margin-top: var(--space-1);
    }

    .description {
        font-size: var(--font-size-4);
        margin-top: var(--space-4);
    }

    .workshopDetails {
        border-block: var(--double-border);
        margin-block: var(--space-8);
        padding-block: var(--space-6);
    }

    .ctaWrapper {
        background-color: var(--color-ivory-1);
        padding-block: var(--space-5);
        padding-inline: var(--space-5);
    }

    .bookingAvailability {
        font-size: var(--font-size-4-sc);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--space-4);
        width: 100%;

        &:has(+ .bookingAvailabilityDescription) {
            margin-bottom: var(--space-1);
        }
    }

    .bookingAvailabilityDescription {
        font-size: var(--font-size-3-sc);
        margin-bottom: var(--space-6);
    }

    .privateWorkshopLink {
        color: var(--color-ivory-10);
        font-size: var(--font-size-3-sc);
        margin-top: var(--space-5);
    }
</style>
