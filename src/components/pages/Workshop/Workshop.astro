---
import { isFilled } from '@prismicio/client'
import getEntryTitle from '@lib/get-entry-title'
import getOgImage from '@lib/get-og-image'
import { client } from '@lib/prismic'

import LayoutWithHeader from '@layouts/LayoutWithHeader.astro'
import SliceZone from '@components/common/SliceZone.astro'
import WorkshopHeader from './WorkshopHeader.astro'

interface Props {
    uid: string
}

const { uid } = Astro.props
const { lang } = Astro.locals

const page = await client.getByUID('workshop', uid, { lang })
const ogImage = getOgImage(page.data.meta_image, page.data.featured_image)
const heading = getEntryTitle(page.data, lang)
const frenchUid =
    lang === 'fr-fr'
        ? page.uid
        : (page.alternate_languages.find((alt) => alt.lang === 'fr-fr')?.uid ??
          page.uid)
---

<LayoutWithHeader
    alternateLanguages={page.alternate_languages}
    description={page.data.meta_description}
    modifiedTime={page.last_publication_date}
    ogImage={ogImage?.url}
    ogImageAlt={ogImage?.alt}
    title={page.data.meta_title ?? heading}
>
    <main id="main">
        <WorkshopHeader
            bookingAvailability={page.data.booking_availability}
            bookingAvailabilityDescription={
                page.data.booking_availability_description
            }
            bookingLink={page.data.booking_link}
            bookingStatus={page.data.booking_status}
            capacity={page.data.capacity}
            description={page.data.description}
            duration={page.data.duration}
            featuredImage={page.data.featured_image}
            language={page.data.language}
            level={page.data.level}
            notifyTag={`atelier-${frenchUid}`}
            price={page.data.price}
            privateWorkshopLink={page.data.private_workshop_link}
            showPrivateWorkshopLink={page.data.show_private_workshop_link}
            subtitle={page.data.subtitle}
            title={page.data.title}
        />

        <div class="workshop bleedGrid">
            {isFilled.sliceZone(page.data.slices) && (
                <SliceZone slices={page.data.slices} workshop={page.data} />
            )}
        </div>
    </main>
</LayoutWithHeader>

<style>
    main {
        container: workshop / inline-size;
    }

    .workshop {
        > :global(div) {
            margin-inline: auto;
            width: 100%;
        }
    }
</style>
