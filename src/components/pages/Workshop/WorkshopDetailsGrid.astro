---
import { UI } from '@lib/i18n'

import WorkshopDetailsGridItem from './WorkshopDetailsGridItem.astro'

import type { WorkshopDocument } from '@typez/generated/prismic'

interface Props {
    ages: WorkshopDocument['data']['ages']
    allergens?: WorkshopDocument['data']['allergens']
    capacity: WorkshopDocument['data']['capacity']
    class?: string
    duration: WorkshopDocument['data']['duration']
    language: WorkshopDocument['data']['language']
    level: WorkshopDocument['data']['level']
    price: WorkshopDocument['data']['price']
}

const {
    ages,
    allergens,
    capacity,
    class: className,
    duration,
    language,
    level,
    price,
    ...rest
} = Astro.props
const { lang } = Astro.locals
---

<dl class:list={['detailsGrid', className]} {...rest}>
    <WorkshopDetailsGridItem item={duration} title={UI[lang].duration} />
    <WorkshopDetailsGridItem item={capacity} title={UI[lang].capacity} />
    <WorkshopDetailsGridItem item={price} title={UI[lang].price} />
    <WorkshopDetailsGridItem item={language} title={UI[lang].language} />
    <WorkshopDetailsGridItem item={level} title={UI[lang].level} />
    <WorkshopDetailsGridItem item={ages} title={UI[lang].ageRange} />
    {allergens && (
        <WorkshopDetailsGridItem
            class="allergens"
            item={allergens}
            title={UI[lang].allergens}
        />
    )}
</dl>

<style>
    .detailsGrid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: var(--space-6) var(--space-4);
        margin-block: var(--space-5);
    }

    .allergens {
        font-size: var(--font-size-4);
        grid-column: 1 / -1;
        max-width: var(--width-text);
    }
</style>
