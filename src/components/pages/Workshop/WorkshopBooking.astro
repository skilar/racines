---
import { getLinkAttrs } from '@lib/prismic-link-resolver'

import WorkshopBookingLink from './WorkshopBookingLink.astro'
import WorkshopNotifyForm from './WorkshopNotifyForm.astro'

import type { WorkshopDocument } from '@typez/generated/prismic'

interface Props {
    bookingAvailability: WorkshopDocument['data']['booking_availability']
    bookingAvailabilityDescription: WorkshopDocument['data']['booking_availability_description']
    bookingLink: WorkshopDocument['data']['booking_link']
    bookingNotifyButtonText: WorkshopDocument['data']['booking_availability_notify_button_text']
    bookingStatus: WorkshopDocument['data']['booking_status']
    notifyTag: string
}

const {
    bookingAvailability,
    bookingAvailabilityDescription,
    bookingLink,
    bookingNotifyButtonText,
    bookingStatus,
    notifyTag,
} = Astro.props

// If we don't have a booking form, we show the notify signup form
const bookingLinkAttrs =
    bookingStatus === 'open' ? getLinkAttrs(bookingLink) : null
---

{bookingLinkAttrs ? (
    <WorkshopBookingLink
        bookingLink={bookingLink}
        bookingStatus={bookingStatus}
    />
) : (
    <WorkshopNotifyForm
        bookingAvailability={bookingAvailability}
        bookingAvailabilityDescription={bookingAvailabilityDescription}
        bookingNotifyButtonText={bookingNotifyButtonText}
        notifyTag={notifyTag}
    />
)}
