---
import { isFilled } from '@prismicio/client'

import PrismicRichText from '@components/common/PrismicRichText.astro'

import type { RichTextField } from '@prismicio/client'

interface Props {
    class?: string
    item: RichTextField
    title: string
}

const { class: className, item, title, ...rest } = Astro.props
---

{isFilled.richText(item) && (
    <div class={className} {...rest}>
        <dt class="title">{title}</dt>
        <dd>
            <PrismicRichText class="item" richText={item} />
        </dd>
    </div>
)}

<style>
    .title {
        font-size: var(--font-size-3-sc);
        font-variant-caps: all-small-caps;
        font-weight: var(--font-weight-medium);
    }

    .item {
        font-size: var(--font-size-4);
    }
</style>
