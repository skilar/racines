{
  "id": "blog_post_link_section",
  "type": "SharedSlice",
  "name": "BlogPostLinkSection",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Default",
      "imageUrl": "",
      "docURL": "...",
      "version": "initial",
      "primary": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": ""
          }
        },
        "caption": {
          "type": "StructuredText",
          "config": {
            "label": "Caption",
            "placeholder": "",
            "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
            "allowTargetBlank": true
          }
        },
        "link": {
          "type": "Link",
          "config": {
            "label": "Link",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true,
            "allowText": true,
            "repeat": false
          }
        },
        "blog_posts": {
          "type": "Group",
          "config": {
            "label": "Blog Posts",
            "repeat": true,
            "fields": {
              "blog_post": {
                "type": "Link",
                "config": {
                  "label": "Blog Post",
                  "select": "document",
                  "customtypes": [
                    {
                      "id": "blog_post",
                      "fields": [
                        "title",
                        "subtitle",
                        "short_description",
                        "cover_image"
                      ]
                    }
                  ],
                  "repeat": false
                }
              }
            }
          }
        }
      }
    }
  ],
  "description": "BlogPostLinkSection"
}
